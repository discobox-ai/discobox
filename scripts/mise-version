#!/bin/sh
set -eu

tool="${1:-}"

case "$tool" in
  go)
    awk '$1 == "go" { print $2; found = 1; exit } END { exit found ? 0 : 1 }' go.mod
    ;;
  task)
    awk '$1 == "github.com/go-task/task/v3" { sub(/^v/, "", $2); print $2; found = 1; exit } END { exit found ? 0 : 1 }' go.mod
    ;;
  *)
    echo "usage: scripts/mise-version go|task" >&2
    exit 2
    ;;
esac
