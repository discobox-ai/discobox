#!/bin/sh
# The root disk is read-only, so everything that survives a pool restart lives
# on the data disk (/dev/vdb) and everything disposable on the cache disk
# (/dev/vdc). containerd's state moves with Docker's: with the containerd
# snapshotter it holds the actual layer content and every container snapshot,
# so losing it is not recoverable.
set -eu

wait_for_block_device() {
    device=$1
    attempts=0
    while [ ! -b "$device" ]; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 300 ]; then
            echo "timed out waiting for $device" >&2
            exit 1
        fi
        sleep 0.1
    done
}

wait_for_block_device /dev/vdb
wait_for_block_device /dev/vdc

# The host creates both disks empty, so the guest owns first-boot formatting.
if ! blkid /dev/vdb >/dev/null 2>&1; then
    mkfs.ext4 -F -q -L discobox-data /dev/vdb
fi
if ! blkid /dev/vdc >/dev/null 2>&1; then
    mkfs.ext4 -F -q -L discobox-cache /dev/vdc
fi

if ! mountpoint -q /var/lib/discobox; then
    mount -t ext4 -o rw /dev/vdb /var/lib/discobox
fi

# The host grows the sparse image when the configured disk size increases, so
# the filesystem is grown to match here. Online growth of a mounted ext4 is
# supported and is a no-op when the filesystem already fills the device.
resize2fs /dev/vdb || true

install -d -m 0755 \
    /var/lib/discobox/cache \
    /var/lib/discobox/docker \
    /var/lib/discobox/containerd \
    /var/lib/discobox/projects \
    /var/lib/discobox/proxy \
    /var/lib/discobox/identity

chmod 0700 /var/lib/discobox/identity

if ! mountpoint -q /var/lib/discobox/cache; then
    mount -t ext4 -o rw /dev/vdc /var/lib/discobox/cache
fi

resize2fs /dev/vdc || true

if ! mountpoint -q /var/lib/docker; then
    mount --bind /var/lib/discobox/docker /var/lib/docker
fi

if ! mountpoint -q /var/lib/containerd; then
    mount --bind /var/lib/discobox/containerd /var/lib/containerd
fi

# This guest's Docker keeps images in containerd's store (daemon.json). A data
# disk a classic-store guest used still holds that store's images, layers and
# containers, which this daemon can neither see nor remove. They are moved
# aside here, before dockerd starts, and deleted by
# discobox-remove-classic-store.service once boot is under way: renames on the
# one filesystem are instant, deleting tens of GiB is not, and the pool waits
# on dockerd. Each step is a rename that leaves a smaller classic store behind,
# so a boot interrupted half way finishes the move on the next one.
#
# What marks the classic store is overlay2's own state: its layer directory and
# its image and layer database under image/overlay2. A containerd-store daemon
# writes neither. containers/ and buildkit/ are shared by both stores, so each
# is split by store, never moved whole: only the containers that name overlay2
# as their driver go, and only BuildKit's classic-store files (moby's
# builder-next: its content store, its metadata and snapshot databases, and
# history.db, which the Docker this guest installs keeps for the classic store
# alone since it names the containerd store's history_c8d.db). cache.db,
# executor/ and net/ are the containerd-store BuildKit's as well; its snapshots
# are held by leases in containerd's own database, which moving its files would
# orphan.
docker_root=/var/lib/discobox/docker
if [ -d "$docker_root/overlay2" ] || [ -d "$docker_root/image/overlay2" ]; then
    install -d -m 0700 /var/lib/discobox/docker-classic-store
    trash=$(mktemp -d /var/lib/discobox/docker-classic-store/store.XXXXXX)
    echo "moving the classic Docker store's data aside for removal"
    if [ -d "$docker_root/containers" ]; then
        mkdir "$trash/containers"
        for container in "$docker_root"/containers/*/; do
            container=${container%/}
            [ -f "$container/config.v2.json" ] || continue
            if grep -q '"Driver":"overlay2"' "$container/config.v2.json"; then
                mv "$container" "$trash/containers/"
            fi
        done
    fi
    for path in \
        buildkit/content \
        buildkit/containerdmeta.db \
        buildkit/history.db \
        buildkit/snapshots.db \
        buildkit/metadata.db \
        buildkit/metadata_v2.db \
        image/overlay2 \
        overlay2; do
        if [ -e "$docker_root/$path" ]; then
            mv "$docker_root/$path" "$trash/$(echo "$path" | tr / -)"
        fi
    done
fi
