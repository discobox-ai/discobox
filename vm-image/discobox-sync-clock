#!/bin/sh
# Step the guest clock to the host's.
#
# Virtualization.framework's PL031 RTC reads the host clock live, so the host's
# time is always one file away and no NTP server or network is involved. Linux
# reads the RTC once at boot, though, and the guest is never told that the Mac
# suspended — so after a laptop sleeps, the guest wakes believing no time
# passed and every signed token it mints or verifies is wrong by the length of
# the nap.
#
# hwclock --hctosys cannot do this here: it waits for an RTC update interrupt
# to get sub-second precision, PL031 raises none, and it exits without setting
# anything ("select() to /dev/rtc0 to wait for clock tick timed out"). Reading
# since_epoch is one atomic value with no tick to wait for.
#
# The step is unconditional. NTP daemons refuse to correct a large offset
# without operator intervention, which is the opposite of what a laptop guest
# needs: the offset is large precisely because the Mac slept.
set -eu

rtc=/sys/class/rtc/rtc0/since_epoch
if [ ! -r "$rtc" ]; then
    echo "no host-backed RTC at $rtc; leaving the clock alone" >&2
    exit 0
fi

host=$(cat "$rtc")
case "$host" in
'' | *[!0-9]*)
    echo "RTC reported %s: $host" >&2
    exit 1
    ;;
esac

now=$(date -u +%s)
drift=$(( host - now ))
if [ "$drift" -lt 0 ]; then
    drift=$(( -drift ))
fi
# A second or two is ordinary scheduling jitter, and stepping the clock every
# 30s for it would be noise in the journal and in anything measuring durations.
if [ "$drift" -le 2 ]; then
    exit 0
fi

date -u -s "@$host" >/dev/null
echo "stepped the guest clock ${drift}s to match the host"
