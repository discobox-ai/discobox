#!/usr/bin/env bash
set -euo pipefail

kernel_dir=$1
config="$kernel_dir/.config"
scripts_config="$kernel_dir/scripts/config"

# libkrunfw intentionally ships a compact nftables-only kernel. Docker's
# iptables-nft frontend still probes and uses x_tables extensions, so build
# those facilities in rather than relying on unavailable kernel modules.
#
# PACKET is here for a different reason: the guest image takes its address from
# DHCP on every backend (ADR 0101 §2), and a DHCP client is an AF_PACKET
# socket. libkrunfw's baseline happens to enable it, which is exactly why it is
# stated — an upstream trim would otherwise land as a guest that boots, runs
# dockerd, and has no address.
#
# BASE_SMALL goes the other way: libkrunfw's baseline sets it, and under it
# PID_MAX_LIMIT is PAGE_SIZE * 8 (32768) and the boot-time pid_max is
# max(4096, 1024 per CPU). One pool VM runs every sandbox in it, so they would
# all share a few thousand PIDs, and Debian's systemd 50-pid-max.conf (4194304),
# which would raise it, fails systemd-sysctl on every boot instead. It also
# sizes other core tables (the futex hash among them) for tiny systems.
"$scripts_config" --file "$config" \
    --disable BASE_SMALL \
    --enable PACKET \
    --enable NETFILTER_XTABLES \
    --enable NFT_COMPAT \
    --enable NETFILTER_XT_MARK \
    --enable NETFILTER_XT_CONNMARK \
    --enable NETFILTER_XT_NAT \
    --enable NETFILTER_XT_TARGET_CHECKSUM \
    --enable NETFILTER_XT_TARGET_CT \
    --enable NETFILTER_XT_TARGET_LOG \
    --enable NETFILTER_XT_TARGET_MASQUERADE \
    --enable NETFILTER_XT_TARGET_REDIRECT \
    --enable NETFILTER_XT_TARGET_TCPMSS \
    --enable NETFILTER_XT_MATCH_ADDRTYPE \
    --enable NETFILTER_XT_MATCH_COMMENT \
    --enable NETFILTER_XT_MATCH_CONNTRACK \
    --enable NETFILTER_XT_MATCH_MARK \
    --enable NETFILTER_XT_MATCH_MULTIPORT \
    --enable NETFILTER_XT_MATCH_PHYSDEV \
    --enable NETFILTER_XT_MATCH_STATE \
    --enable NETFILTER_XT_MATCH_TCPMSS \
    --enable IP_NF_IPTABLES \
    --enable IP_NF_FILTER \
    --enable IP_NF_NAT \
    --enable IP_NF_MANGLE \
    --enable IP_NF_RAW \
    --enable IP6_NF_IPTABLES \
    --enable IP6_NF_FILTER \
    --enable IP6_NF_NAT \
    --enable IP6_NF_MANGLE \
    --enable IP6_NF_RAW \
    --enable MACVLAN \
    --enable IPVLAN \
    --enable VXLAN \
    --enable VLAN_8021Q

make -C "$kernel_dir" olddefconfig

for required in \
    CONFIG_PACKET=y \
    CONFIG_NETFILTER_XTABLES=y \
    CONFIG_NFT_COMPAT=y \
    CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y \
    CONFIG_IP_NF_IPTABLES=y \
    CONFIG_IP6_NF_IPTABLES=y \
    CONFIG_BRIDGE=y \
    CONFIG_VETH=y \
    CONFIG_OVERLAY_FS=y \
    CONFIG_MACVLAN=y \
    CONFIG_IPVLAN=y \
    CONFIG_VXLAN=y; do
    grep -qx "$required" "$config" || {
        echo "required kernel setting missing after olddefconfig: $required" >&2
        exit 1
    }
done

# Absent from the config is off too: the option only has a prompt under EXPERT.
if grep -q '^CONFIG_BASE_SMALL=y' "$config"; then
    echo "kernel setting still enabled after olddefconfig: CONFIG_BASE_SMALL" >&2
    exit 1
fi
