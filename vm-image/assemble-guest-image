#!/bin/sh
# Turn an exported guest root filesystem into a boot artifact set: an
# uncompressed kernel, an initrd, a raw ext4 root filesystem, and the list of
# packages the root was built from.
#
# Everything here runs inside the image build (ADR 0062 §6). mkfs.ext4 -d
# populates an image file without a loop device and without privileges, which
# is what lets this same build run on a developer's Linux box, in CI, and on
# BuildKit inside a running pool VM.
set -eu

rootfs=${1:?usage: assemble-guest-image ROOTFS OUTPUT_DIR}
out=${2:?usage: assemble-guest-image ROOTFS OUTPUT_DIR}
arch=${TARGETARCH:?assemble-guest-image: TARGETARCH must be set}
slack_mib=${ROOT_SLACK_MIB:-32}
# What the guest calls itself. One name for every pool VM: they are separate
# machines that never share a network namespace, and a name an operator
# recognises beats one that is unique to a VM they already know they are on.
hostname=discobox

mkdir -p "$out"

kernel=$(find "$rootfs/boot" -maxdepth 1 -name 'vmlinuz-*' | sort -V | tail -n 1)
initrd=$(find "$rootfs/boot" -maxdepth 1 -name 'initrd.img-*' | sort -V | tail -n 1)
if [ -z "$kernel" ] || [ -z "$initrd" ]; then
    echo "assemble-guest-image: no kernel or initrd in $rootfs/boot" >&2
    exit 1
fi

# An arm64 Image carries "ARMd" at offset 0x38. This is both how a compression
# format is confirmed to have produced a kernel and how an already-uncompressed
# vmlinuz is recognised.
is_kernel_image() {
    [ -s "$1" ] && [ "$(dd if="$1" bs=1 skip=56 count=4 2>/dev/null)" = "ARMd" ]
}

# le N FILE OFFSET prints the N-byte (2 or 4) little-endian unsigned integer
# at OFFSET in FILE.
le() {
    od -An -t "u$1" --endian=little -j "$3" -N "$1" "$2" | tr -d ' \n'
}

# text FILE OFFSET COUNT prints COUNT bytes at OFFSET in FILE, NULs dropped.
text() {
    dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | tr -d '\000'
}

# slice FILE OFFSET SIZE OUT copies SIZE bytes at OFFSET in FILE to OUT.
slice() {
    tail -c +"$(($2 + 1))" "$1" | head -c "$3" >"$4"
}

# unwrap_stub IN OUT copies the kernel out of an EFI stub that carries it as a
# PE section named .linux, as Ubuntu's arm64 kernel is shipped (a stub that
# also carries device trees, .dtbauto, for the machines it boots on bare
# metal), and fails when IN is not such a stub.
unwrap_stub() {
    [ "$(text "$1" 0 2)" = MZ ] || return 1
    pe=$(le 4 "$1" 60)
    [ "$(text "$1" "$pe" 4)" = PE ] || return 1
    sections=$(le 2 "$1" $((pe + 6)))
    table=$((pe + 24 + $(le 2 "$1" $((pe + 20)))))
    i=0
    while [ "$i" -lt "$sections" ]; do
        entry=$((table + i * 40))
        if [ "$(text "$1" "$entry" 8)" = .linux ]; then
            slice "$1" "$(le 4 "$1" $((entry + 20)))" "$(le 4 "$1" $((entry + 16)))" "$2"
            return 0
        fi
        i=$((i + 1))
    done
    return 1
}

# unwrap_zboot IN OUT copies the compressed payload out of an EFI zboot image
# ("zimg" at offset 4, the payload's offset and size at 8 and 12, its
# compression's name at 24), and fails when IN is not one.
unwrap_zboot() {
    [ "$(text "$1" 4 4)" = zimg ] || return 1
    echo "assemble-guest-image: $kernel is an EFI zboot image, $(text "$1" 24 32)-compressed"
    slice "$1" "$(le 4 "$1" 8)" "$(le 4 "$1" 12)" "$2"
}

case "$arch" in
arm64)
    # A hypervisor that loads a kernel directly requires an uncompressed one.
    # Which form a distribution ships is not a constant: Debian's arm64 kernel
    # was a raw Image; Ubuntu's is an EFI stub whose .linux section is an EFI
    # zboot image whose payload is a zstd-compressed Image. Unwrap and detect rather
    # than assume, so a kernel packaging change is not a silent boot failure
    # on a host that cannot be debugged from. Doing it here also means the
    # published artifact is always bootable and no server carries a kernel
    # decompressor.
    work=$(mktemp -d)
    image=$kernel
    if unwrap_stub "$image" "$work/linux"; then
        echo "assemble-guest-image: took the kernel out of $kernel's .linux section"
        image=$work/linux
    fi
    if unwrap_zboot "$image" "$work/payload"; then
        image=$work/payload
    fi
    if is_kernel_image "$image"; then
        echo "assemble-guest-image: $kernel is already an uncompressed kernel Image"
        cp "$image" "$out/vmlinux"
    else
        for format in gzip zstd xz lz4; do
            case "$format" in
            gzip) gzip -dc "$image" >"$out/vmlinux" 2>/dev/null || true ;;
            zstd) zstd -dc "$image" >"$out/vmlinux" 2>/dev/null || true ;;
            xz) xz -dc "$image" >"$out/vmlinux" 2>/dev/null || true ;;
            lz4) lz4 -dc "$image" >"$out/vmlinux" 2>/dev/null || true ;;
            esac
            if is_kernel_image "$out/vmlinux"; then
                echo "assemble-guest-image: decompressed $kernel with $format"
                break
            fi
            rm -f "$out/vmlinux"
        done
    fi
    rm -rf "$work"
    if ! is_kernel_image "$out/vmlinux"; then
        echo "assemble-guest-image: $kernel is not an arm64 kernel Image and no known compression produced one" >&2
        exit 1
    fi
    ;;
amd64)
    # No vmlinux is published for amd64, and that is not an omission. The one
    # backend that boots this architecture is libkrun, which requires the
    # libkrunfw-patched kernel from kernel/Dockerfile and would not load
    # Ubuntu's in any form. Extracting an amd64 bzImage's payload from its boot
    # stub is real work with no consumer: ADR 0062 defers Intel Macs, and they
    # are the only thing that would want it.
    echo "assemble-guest-image: not publishing a vmlinux for amd64; libkrun boots its own patched kernel"
    ;;
*)
    echo "assemble-guest-image: unsupported architecture $arch" >&2
    exit 1
    ;;
esac

cp "$initrd" "$out/initrd.img"

# A rebuild installs the newest packages in the release's pockets rather than
# replaying a snapshot (ADR 26-11-16-365 §2), so what a published guest holds
# is recorded with it: every package, its version and architecture.
dpkg-query --admindir="$rootfs/var/lib/dpkg" -W -f '${Package}\t${Version}\t${Architecture}\n' >"$out/packages.txt"
sort -o "$out/packages.txt" "$out/packages.txt"
if [ ! -s "$out/packages.txt" ]; then
    echo "assemble-guest-image: $rootfs has no dpkg database to list its packages from" >&2
    exit 1
fi

# The lockup detectors are built into Ubuntu's kernel, not modules, so the
# kernel's config is the only place to see them, and it leaves with /boot
# below. A guest whose CPU hard-locks with no detector just stops answering,
# with nothing on its console (#1101). The modules the guest needs are checked
# on the artifact by `task vm:verify`.
config=$(find "$rootfs/boot" -maxdepth 1 -name 'config-*' | sort -V | tail -n 1)
for required in CONFIG_SOFTLOCKUP_DETECTOR=y CONFIG_HARDLOCKUP_DETECTOR=y; do
    if [ -z "$config" ] || ! grep -qx "$required" "$config"; then
        echo "assemble-guest-image: the kernel's config (${config:-none}) lacks $required" >&2
        exit 1
    fi
done

# The kernel and the initrd are artifacts of their own from here on; the guest
# never reads /boot, because the hypervisor loads both from the host. Leaving
# them in the tree ships each one twice.
rm -rf "${rootfs:?}"/boot/*

# BuildKit supplies /etc/resolv.conf as a bind mount during RUN steps, so the
# exported tree carries the builder's resolver. The guest resolves through
# systemd-resolved against whichever DHCP server its host's user-mode network
# runs — Virtualization.framework's NAT attachment, or passt.
rm -f "$rootfs/etc/resolv.conf"
ln -s /run/systemd/resolve/resolv.conf "$rootfs/etc/resolv.conf"

# Two more files a container runtime supplies and a VM does not.
#
# /etc/hostname ships in a distribution's base image naming whatever built it
# (Debian's said "debuerreotype"). No container ever sees it — the runtime
# bind-mounts its own over the top — but nothing masks it here, so the guest
# came up calling itself that, which is what an operator on the pool console
# reads and what every log line from inside carries.
#
# /etc/hosts is the same arrangement in reverse: the runtime provides one, so
# the image carries none at all, and a VM booting this tree would have no entry
# for localhost or for its own name.
echo "$hostname" > "$rootfs/etc/hostname"
cat > "$rootfs/etc/hosts" <<HOSTS
127.0.0.1	localhost
127.0.1.1	$hostname
::1	localhost ip6-localhost ip6-loopback
fe00::	ip6-localnet
ff00::	ip6-mcastprefix
ff02::1	ip6-allnodes
ff02::2	ip6-allrouters
HOSTS

# Size the root filesystem to its contents rather than to a fixed ceiling. It is
# read-only and never grows, and every byte of slack is a byte pulled over the
# network on a machine's first pool start and written to disk on extraction.
used_mib=$(du -sm "$rootfs" | cut -f1)
root_mib=$(( used_mib * 105 / 100 + slack_mib ))
truncate -s "${root_mib}M" "$out/root.ext4"
# Every option here is set because the default is wrong for a read-only image
# whose size is a distribution cost:
#
#   ^has_journal  nothing writes to this filesystem, so a journal is dead weight
#   -m 0          the 5% ext4 reserves for root keeps a *full* filesystem
#                 recoverable, which this one cannot become
#   -b 4096       mke2fs picks the block size from the image size, and an image
#                 under 512 MiB gets 1 KiB blocks — four times the metadata and
#                 four times the I/O for a filesystem every pool on the host
#                 reads from
#   -i 16384      the matching default packs one inode per 4 KiB, which is
#                 ~90k unused inodes and about 18 MiB of inode tables here
mkfs.ext4 -F -q -m 0 -b 4096 -i 16384 -L discobox-root -O ^has_journal \
    -d "$rootfs" "$out/root.ext4"

echo "guest artifacts:"
ls -l "$out"
