tmpfs /tmp tmpfs mode=1777,nosuid,nodev 0 0
tmpfs /var/log tmpfs mode=0755,nosuid,nodev 0 0
tmpfs /var/tmp tmpfs mode=1777,nosuid,nodev 0 0
# The Mac's /Users, exported by a vz host as a read-only virtiofs share and
# mounted here at the same absolute path it has on the Mac. That equality is the
# point: the pool agent binds a developer's checkout into a sandbox by its host
# path, so the two spellings have to be one string.
#
# nofail because the device is the host's to attach and this image is released
# on its own line: a guest booted by a server that shares nothing — every
# libkrun guest today, and a vz host with no /Users — must still come up, with
# an empty /Users, rather than dropping to an emergency shell.
#
# So a libkrun boot prints "FAILED Failed to mount /Users" on the serial
# console, every time, and that is expected rather than a fault to chase. It is
# the one failed unit this image tolerates: there is no device node to condition
# a virtiofs tag on, an automount would only move the failure to first access,
# and conditioning on the hypervisor is the per-backend branch ADR 0101 §1
# exists to prevent.
discobox-users /Users virtiofs ro,nofail 0 0
