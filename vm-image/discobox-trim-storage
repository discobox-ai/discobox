#!/bin/sh
# Hands the blocks the guest has freed on the data and cache disks back to the
# host. Both disks are sparse files on the host, and a block the guest frees is
# only returned when the guest discards it: the filesystems are mounted without
# online discard, so this trim, run by discobox-trim-storage.timer, is what
# keeps a pool's disk files from only ever growing after its boxes and images
# are removed.
#
# Whether a trim reaches the host file is the hypervisor's: a virtio disk that
# does not advertise discard reports a zero discard_max_bytes, which is logged,
# and one that advertises it but refuses the request is passed over by
# --quiet-unsupported. Neither is a failure. The guest boots on every backend,
# and a unit that fails on one of them is a failed unit on its serial console,
# every time. Each disk is trimmed whatever happened to the other.
set -u

trim() {
    device=$1
    mountpoint=$2
    max=$(cat "/sys/block/$device/queue/discard_max_bytes" 2>/dev/null || echo 0)
    if [ "$max" = 0 ]; then
        echo "$mountpoint: /dev/$device does not accept discard; freed space stays allocated on the host"
        return 0
    fi
    fstrim --verbose --quiet-unsupported "$mountpoint"
}

status=0
trim vdb /var/lib/discobox || status=1
trim vdc /var/lib/discobox/cache || status=1
exit "$status"
