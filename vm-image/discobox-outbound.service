[Unit]
Description=Pool outbound routing and trust before Docker
Before=docker.service
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/discobox-vsock-guest outbound
Restart=on-failure
RestartSec=1
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
