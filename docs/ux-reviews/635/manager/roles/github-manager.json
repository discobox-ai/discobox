{
  "version": 1,
  "description": "The manager's own use in a watched repository: read, file and comment on issues, set labels, close issues, re-run failed CI. No git access, no PRs, no merge.",
  "parameters": {
    "owner": {
      "type": "pathSegment"
    },
    "repo": {
      "type": "pathSegment"
    }
  },
  "routes": [
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "GET"
      ],
      "paths": [
        "/repos/${owner}/${repo}",
        "/repos/${owner}/${repo}/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "GET"
      ],
      "paths": [
        "/search/issues"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "paths": [
        "/graphql"
      ],
      "graphql": {
        "operations": [
          "query"
        ]
      }
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/comments"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "PATCH"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/labels"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "DELETE"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/labels/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/actions/runs/*/rerun-failed-jobs"
      ]
    }
  ]
}
