# direnv entry point. Everything it sets up lives in the flake's devShell, so
# `nix develop` gives the same environment without direnv (ADR 0066 §3).

if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Nix's devShell exports its build sandbox's temp directory as TMPDIR, and a
# fresh one is minted per evaluation -- so every shell that loads this file gets
# a different /tmp/nix-shell.XXXXXX, and the one it gets is deleted when the
# evaluating process exits.
#
# discobox derives its local endpoint from os.TempDir() when XDG_RUNTIME_DIR is
# unset (endpoint.DefaultEndpoint), on both ends: the server binds it and the
# CLI dials it. Under nix's TMPDIR that path stops being a rendezvous point and
# becomes per-shell identity -- the server binds one, your next terminal dials
# another, and the CLI autolaunches a second server rather than finding yours.
#
# Restoring TMPDIR is what keeps the two ends agreeing. Pinning DISCOBOX_SERVER
# instead would fix only the client: the server's socket comes from the same
# default, so it would need the path spelled out again in the service's
# DISCOBOX_SERVER_LISTEN. This also keeps `go test`'s t.TempDir() and everything
# else off a directory that may already be gone.
_discobox_tmpdir=${TMPDIR-}

use flake

if [ -n "$_discobox_tmpdir" ]; then
  export TMPDIR="$_discobox_tmpdir" TEMP="$_discobox_tmpdir" TMP="$_discobox_tmpdir" TEMPDIR="$_discobox_tmpdir"
else
  unset TMPDIR TEMP TMP TEMPDIR
fi
unset _discobox_tmpdir
