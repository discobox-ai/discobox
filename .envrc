if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

use flake
PATH_add ./build

export DISCO2_COMPLETION_DIR="$PWD/build/completions"
export DISCO2_BASH_COMPLETION="$DISCO2_COMPLETION_DIR/disco2.bash"
export DISCO2_ZSH_COMPLETION="$DISCO2_COMPLETION_DIR/_disco2"
export DISCO2_FISH_COMPLETION="$DISCO2_COMPLETION_DIR/disco2.fish"
export DISCO2_BASH_COMPLETION_USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"

if [ -x "$PWD/build/disco2" ]; then
  mkdir -p "$DISCO2_COMPLETION_DIR"
  "$PWD/build/disco2" completion bash > "$DISCO2_BASH_COMPLETION"
  "$PWD/build/disco2" completion zsh > "$DISCO2_ZSH_COMPLETION"
  "$PWD/build/disco2" completion fish > "$DISCO2_FISH_COMPLETION"

  mkdir -p "$DISCO2_BASH_COMPLETION_USER_DIR"
  cp "$DISCO2_BASH_COMPLETION" "$DISCO2_BASH_COMPLETION_USER_DIR/disco2"
fi
