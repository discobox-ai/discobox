# shellcheck shell=bash # direnv evaluates this in bash.
# direnv entry point. Everything it sets up lives in the flake's devShell, so
# `nix develop` gives the same environment without direnv (ADR 0066 §3).

if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
  # shellcheck disable=SC1091 # Nix's own, present only once a profile exists.
  . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Nix's devShell exports its build sandbox's temp directory as TMPDIR, and a
# fresh one is minted per evaluation -- so every shell that loads this file gets
# a different /tmp/nix-shell.XXXXXX, and the one it gets is deleted when the
# evaluating process exits.
#
# Restoring TMPDIR keeps `go test`'s t.TempDir() and everything else in the
# shell off a directory that may already be gone. The discobox endpoint does not
# depend on it: the flake's shellHook pins DISCOBOX_SERVER_ADDRESS, which covers
# `nix develop` without direnv too.
_discobox_tmpdir=${TMPDIR-}

use flake

if [ -n "$_discobox_tmpdir" ]; then
  export TMPDIR="$_discobox_tmpdir" TEMP="$_discobox_tmpdir" TMP="$_discobox_tmpdir" TEMPDIR="$_discobox_tmpdir"
else
  unset TMPDIR TEMP TMP TEMPDIR
fi
unset _discobox_tmpdir
