{
  "$description": "The discobox design language's tokens. LANGUAGE.md says what each is for. $value is the dark theme, the canonical one; $extensions.ai.discobox carries the light value and, where the TUI uses the role, its xterm-256 index. Generate tokens.css with `go tool task brand:tokens`; never edit a consumer's copy.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#0a0410",
      "$description": "Page and window background.",
      "$extensions": {
        "ai.discobox": {
          "light": "#f7f4fa"
        }
      }
    },
    "ink-raised": {
      "$type": "color",
      "$value": "#150b1f",
      "$description": "Cards, frames, panels.",
      "$extensions": {
        "ai.discobox": {
          "light": "#ffffff"
        }
      }
    },
    "ink-sunken": {
      "$type": "color",
      "$value": "#06020a",
      "$description": "Code blocks, inputs, terminal panes.",
      "$extensions": {
        "ai.discobox": {
          "light": "#eee8f4"
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "#2a1839",
      "$description": "Hairlines and unfocused frames.",
      "$extensions": {
        "ai.discobox": {
          "light": "#e1d8ea",
          "xterm": 236
        }
      }
    },
    "line-bright": {
      "$type": "color",
      "$value": "#3d2352",
      "$description": "Dividers that must show; hover outlines.",
      "$extensions": {
        "ai.discobox": {
          "light": "#c9bad8",
          "xterm": 238
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#f4ecf9",
      "$description": "Body and headings. In the TUI, the terminal's foreground.",
      "$extensions": {
        "ai.discobox": {
          "light": "#1d1424"
        }
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "#b0a0bf",
      "$description": "Secondary text and captions.",
      "$extensions": {
        "ai.discobox": {
          "light": "#5e4f6c",
          "xterm": 245
        }
      }
    },
    "text-faint": {
      "$type": "color",
      "$value": "#7c6a8c",
      "$description": "Hints, disabled, metadata.",
      "$extensions": {
        "ai.discobox": {
          "light": "#8a7b98",
          "xterm": 240
        }
      }
    },
    "magenta": {
      "$type": "color",
      "$value": "#f45cff",
      "$description": "The accent: focus, selection, links, the recommended choice. The TUI uses #f45cff as truecolor.",
      "$extensions": {
        "ai.discobox": {
          "light": "#a81fbd"
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "#9e4aa7",
      "$description": "The mark's own purple, for brand art only.",
      "$extensions": {
        "ai.discobox": {
          "light": "#9e4aa7"
        }
      }
    },
    "violet": {
      "$type": "color",
      "$value": "#8b2fd6",
      "$description": "Second light: background glow and gradients.",
      "$extensions": {
        "ai.discobox": {
          "light": "#6d22b0"
        }
      }
    },
    "gold": {
      "$type": "color",
      "$value": "#ffd700",
      "$description": "The one title band per view, key hints, the cursor chevron.",
      "$extensions": {
        "ai.discobox": {
          "light": "#e8c200",
          "xterm": 220
        }
      }
    },
    "on-gold": {
      "$type": "color",
      "$value": "#0a0410",
      "$description": "Text on the gold band.",
      "$extensions": {
        "ai.discobox": {
          "light": "#0a0410",
          "xterm": 232
        }
      }
    },
    "ok": {
      "$type": "color",
      "$value": "#5fff5f",
      "$description": "Running state, success.",
      "$extensions": {
        "ai.discobox": {
          "light": "#1a7a34",
          "xterm": 83
        }
      }
    },
    "green": {
      "$type": "color",
      "$value": "#87ff87",
      "$description": "Diff additions, a finished agent.",
      "$extensions": {
        "ai.discobox": {
          "light": "#237a3a",
          "xterm": 120
        }
      }
    },
    "salmon": {
      "$type": "color",
      "$value": "#ffaf87",
      "$description": "Diff deletions.",
      "$extensions": {
        "ai.discobox": {
          "light": "#b4532a",
          "xterm": 216
        }
      }
    },
    "warn": {
      "$type": "color",
      "$value": "#ffaf00",
      "$description": "Needs attention soon; status messages.",
      "$extensions": {
        "ai.discobox": {
          "light": "#a35f00",
          "xterm": 214
        }
      }
    },
    "err": {
      "$type": "color",
      "$value": "#ff6b62",
      "$description": "Failed, blocked.",
      "$extensions": {
        "ai.discobox": {
          "light": "#b3261e",
          "xterm": 196
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "#87afff",
      "$description": "Neutral notices.",
      "$extensions": {
        "ai.discobox": {
          "light": "#2c5fb8",
          "xterm": 111
        }
      }
    },
    "selection": {
      "$type": "color",
      "$value": "#2a1530",
      "$description": "The cursor row and selected text.",
      "$extensions": {
        "ai.discobox": {
          "light": "#f3defa",
          "xterm": 237
        }
      }
    }
  },
  "font": {
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "$description": "The voice: headings, interface, keys, IDs, data, code, terminals."
    },
    "prose": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ],
      "$description": "Long-form prose on the web and in documents only."
    }
  },
  "size": {
    "step-3": {
      "$type": "dimension",
      "$value": "2.5rem",
      "$description": "Page title, 700, tracking -0.02em."
    },
    "step-2": {
      "$type": "dimension",
      "$value": "1.75rem",
      "$description": "Section heading, 700, tracking -0.015em."
    },
    "step-1": {
      "$type": "dimension",
      "$value": "1.25rem",
      "$description": "Sub-heading and lede, 600."
    },
    "step-0": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "Body and interface, 400."
    },
    "step--1": {
      "$type": "dimension",
      "$value": "0.8125rem",
      "$description": "Captions, hints, table headers, eyebrows, 500."
    }
  },
  "space": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "space-5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "space-7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "space-8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "radius-key": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Keys and chips."
    },
    "radius-row": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Rows and bands."
    },
    "radius-card": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Cards."
    },
    "radius-frame": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Frames and panes."
    }
  },
  "stroke": {
    "stroke-focus": {
      "$type": "dimension",
      "$value": "1.5px",
      "$description": "A focused frame, in the accent."
    },
    "stroke-quiet": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "An unfocused frame, in --line."
    }
  }
}
