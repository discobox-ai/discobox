[Unit]
Description=Discobox Pool Build Registry
Documentation=https://github.com/discobox-ai/discobox
# Its configuration is rendered by the pool agent before it reports itself
# started (Type=notify there).
Requires=discobox-pool-agent.service
After=network-online.target discobox-pool-agent.service
Wants=network-online.target

[Service]
Type=simple
# Storage root and listen address are pool-scoped, so the unit cannot
# address its own state without this.
EnvironmentFile=/etc/discobox/registry.env
ExecStartPre=/usr/bin/install -d -m 0700 ${REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY}
ExecStart=/usr/local/bin/registry serve /etc/discobox/registry.yml
Restart=on-failure
RestartSec=2s
KillMode=mixed

[Install]
WantedBy=multi-user.target
