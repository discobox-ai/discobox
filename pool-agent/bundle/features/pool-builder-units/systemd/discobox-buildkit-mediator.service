[Unit]
Description=Discobox Pool BuildKit Mediator
Documentation=https://github.com/discobox-ai/discobox
Wants=discobox-pool-agent.service
After=discobox-buildkitd.service discobox-pool-agent.service
Wants=discobox-buildkitd.service
# Retried for as long as the box is a pool's, as the agent is: a load that
# fails at boot (no default route yet) must not leave it down for good.
StartLimitIntervalSec=0

[Service]
Type=simple
# Shares the proxy unit's environment: both need the pool identity to address
# the certificate bundle they authenticate with, and both run with a clean
# systemd environment.
EnvironmentFile=/etc/discobox/proxy.env
# grpc-go 1.67 began rejecting TLS connections whose client negotiated no ALPN
# protocol, before any stream exists. buildx's client does not send one, so
# every build failed as a bare connection timeout with nothing logged server
# side — while buildctl, which ships a newer grpc-go that does send ALPN,
# worked against the same endpoint and made this look buildx-specific.
# Sandboxes reach this listener only over the per-pool internal network, and
# the connection is still mTLS; ALPN enforcement is not what authenticates it.
Environment=GRPC_ENFORCE_ALPN_ENABLED=false
# Not without the rule set that keeps an in-machine credential's endpoint
# from it, on a pool whose driver declares one (ADR 26-11-11-080 §9), read
# from the bootstrap as the agent reads it.
Environment=DISCOBOX_POOL_BOOTSTRAP_FILE=/etc/discobox/pool-agent/bootstrap.json
ExecStartPre=/usr/local/bin/discobox-pool-agent in-machine-fence
ExecStart=/usr/local/bin/discobox-pool-agent buildkit-mediator
Restart=on-failure
RestartSec=2s
KillMode=mixed
# A stop drains the builds already on the mediator rather than cutting their
# streams (buildkitagent.BuildDrain, 10 minutes). systemd's default stop timeout
# is well under that and would SIGKILL the drain partway, so it is raised past
# it: the mediator gives up on its own, and this is only the backstop for a
# mediator that does not.
TimeoutStopSec=11min

[Install]
WantedBy=multi-user.target
