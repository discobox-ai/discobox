[Unit]
Description=Discobox Pool Agent
Documentation=https://github.com/discobox-ai/discobox
After=network-online.target
Wants=network-online.target
# Restarted for as long as the box is a pool's: a control plane that is down
# is waited out, never given up on.
StartLimitIntervalSec=0

[Service]
# Ready once it has written the proxy's environment, CA and control key, and
# on a Docker pool the builder's and registry's configuration, which their
# units are ordered after.
Type=notify
Environment=DISCOBOX_POOL_BOOTSTRAP_FILE=/etc/discobox/pool-agent/bootstrap.json
# What the box's maker sets beside the bootstrap: the pool's policy the agent
# reads from its environment (retention, the sandbox base image, the idle
# timeout). Optional, since a maker may set none.
EnvironmentFile=-/etc/discobox/pool-agent/environment
ExecStart=/usr/local/bin/discobox-pool-agent
Restart=always
RestartSec=2s
KillMode=mixed

[Install]
WantedBy=multi-user.target
