[Unit]
Description=Discobox Pool Proxy
Documentation=https://github.com/discobox-ai/discobox
# The agent's start is the proxy's environment, CA and control key written
# (Type=notify there); a proxy started before them has nothing to run with.
Requires=discobox-pool-agent.service
After=network-online.target discobox-pool-agent.service
Wants=network-online.target
# Retried for as long as the box is a pool's, as the agent is: a load that
# fails at boot (no default route yet) must not leave it down for good.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/discobox/proxy.env
# Not without the rule set that keeps an in-machine credential's endpoint
# from it, on a pool whose driver declares one (ADR 26-11-11-080 §9), read
# from the bootstrap as the agent reads it.
Environment=DISCOBOX_POOL_BOOTSTRAP_FILE=/etc/discobox/pool-agent/bootstrap.json
ExecStartPre=/usr/local/bin/discobox-pool-agent in-machine-fence
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/discobox/proxy
ExecStart=/usr/local/bin/discobox-pool-agent proxy
Restart=on-failure
RestartSec=2s
KillMode=mixed

[Install]
WantedBy=multi-user.target
