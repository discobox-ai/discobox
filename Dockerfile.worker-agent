# syntax=docker/dockerfile:1

FROM golang:1.26-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
COPY gormdb/go.mod gormdb/go.sum ./gormdb/
COPY orchestration/go.mod orchestration/go.sum ./orchestration/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/discobox-worker-agent ./cmd/discobox-worker-agent

FROM ubuntu:24.04

ENV container=docker
ENV DISCOBOX_AGENT_PORT=3002

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dbus \
        systemd \
        systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl mask \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        systemd-remount-fs.service \
        getty.target \
        console-getty.service

COPY --from=build /out/discobox-worker-agent /usr/local/bin/discobox-worker-agent

RUN cat >/etc/systemd/system/discobox-worker-agent.service <<'EOF'
[Unit]
Description=Discobox worker agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISCOBOX_AGENT_PORT=3002
PassEnvironment=DISCOBOX_CONTROL_PLANE_URL DISCOBOX_TENANT_ID DISCOBOX_PROJECT_ID DISCOBOX_SANDBOX_ID DISCOBOX_WORKER_ID DISCOBOX_WORKER_BOOTSTRAP_TOKEN DISCOBOX_AGENT_PORT
ExecStart=/usr/local/bin/discobox-worker-agent
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
EOF

RUN systemctl enable discobox-worker-agent.service

EXPOSE 3002
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
