  "info": {
    "title": "Disco2 Sandbox Manager",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/projects": {
      "get": {
        "operationId": "list-projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProjectsBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List projects",
        "tags": [
          "Projects"
        ]
      }
    },
    "/projects/{projectId}": {
      "get": {
        "operationId": "get-project",
        "parameters": [
          {
            "description": "Project ID",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "description": "Project ID",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get a project",
        "tags": [
          "Projects"
        ]
      }
    },
    "/projects/{projectId}/events": {
      "get": {
        "operationId": "subscribe-project-events",
        "parameters": [
          {
            "description": "Project ID",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "description": "Project ID",
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Resource types to watch. Repeat the parameter or use comma-separated values. Defaults to sandbox.",
            "explode": false,
            "in": "query",
            "name": "resources",
            "schema": {
              "description": "Resource types to watch. Repeat the parameter or use comma-separated values. Defaults to sandbox.",
              "items": {
                "type": "string"
              },
              "nullable": true,
              "type": "array"
            }
          },
          {
            "description": "Replay changes after this sequence. Omit for list-watch baseline behavior. A value of 0 starts at the current max sequence.",
            "explode": false,
            "in": "query",
            "name": "afterSeq",
            "schema": {
              "default": -1,
              "description": "Replay changes after this sequence. Omit for list-watch baseline behavior. A value of 0 starts at the current max sequence.",
              "format": "int64",
              "minimum": -1,
              "type": "integer"
            }
          },
          {
            "description": "When afterSeq is omitted, send a full list of requested resources before live changes",
            "explode": false,
            "in": "query",
            "name": "list",
            "schema": {
              "description": "When afterSeq is omitted, send a full list of requested resources before live changes",
              "type": "boolean"
            }
          },
          {
            "description": "Return after replay/list instead of waiting for live events",
            "explode": false,
            "in": "query",
            "name": "replayOnly",
            "schema": {
              "description": "Return after replay/list instead of waiting for live events",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "Each oneOf object in the array represents one possible Server Sent Events (SSE) message, serialized as UTF-8 text according to the SSE specification.",
                  "items": {
                    "oneOf": [
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/ResourceListFinishEvent"
                          },
                          "event": {
                            "const": "listFinish",
                            "description": "The event name.",
                            "type": "string"
                          },
                          "id": {
                            "description": "The event ID.",
                            "type": "integer"
                          },
                          "retry": {
