{
  "name": "discobox-tooling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:mermaid": "node scripts/validate-mermaid.mjs",
    "check:ts": "oxlint --deny-warnings harness && pnpm run check:ts-fmt && tsc -p harness",
    "check:ts-fmt": "oxfmt --check 'harness/**/*.{ts,mts}'",
    "fmt:ts": "oxfmt 'harness/**/*.{ts,mts}'"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "mermaid": "11.15.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.9.0"
  }
}
