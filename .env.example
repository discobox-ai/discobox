# Discobox discobox-server
# Copy this file to .env and adjust as needed.
#
# Usage: cp .env.example .env
#
# XDG Base Directory Compliance:
# By default, the server stores data in XDG-compliant directories:
#   - Database: sqlite3://$XDG_DATA_HOME/discobox/discobox.db
#
# Override these with environment variables if needed.

# Server
PORT=8080

# Listeners
# The server binds local IPC and nothing else unless told to: each TCP listener
# is a machine-wide surface, so both are opted into. `task dev` sets these two
# to loopback for you, and does so in the environment — which means setting them
# here has no effect under `task dev`, since the server's .env load does not
# replace a variable that is already set. Override from the shell instead.
# DISCOBOX_SERVER_LISTEN=http://127.0.0.1:8080
# DISCOBOX_SSH_LISTEN=127.0.0.1:3222
# DISCOBOX_SSH_ADVERTISE_ADDRESS=

# Application directories
# DISCOBOX_DATA_DIR=
# DISCOBOX_CONFIG_DIR=
# DISCOBOX_CACHE_DIR=
# DISCOBOX_STATE_DIR=

# Database
# Default: sqlite3://$XDG_DATA_HOME/discobox/discobox.db
# DATABASE_DSN=sqlite3://./discobox.db
# DATABASE_READ_DSN=
# DATABASE_DRIVER=sqlite

# Jobs
# JOB_MAX_ATTEMPTS=3

# Secrets
# Base64-encoded 32-byte key used to encrypt secret database fields at rest.
# Generate this with internal/secrets.GenerateBase64Key from a trusted setup tool.
# DISCOBOX_ENCRYPTION_KEY=

# Dispatcher
# DISPATCHER_ENABLED=true
# DISPATCHER_POLL_INTERVAL=1s
# DISPATCHER_JOB_TIMEOUT=1m
# DISPATCHER_STALE_JOB_TIMEOUT=5m
# DISPATCHER_IMMEDIATE_EXECUTION=true
# DISPATCHER_DEFAULT_CONCURRENCY=1
# SANDBOX_RECONCILE_JOB_CONCURRENCY=4

# Docker development worker image
# task dev updates these automatically when Dockerfile inputs change.
# DISCOBOX_DOCKER_WORKER_IMAGE=
# DISCOBOX_DOCKER_WORKER_IMAGE_DIGEST=

# Default sandbox image
# task dev updates these automatically when Dockerfile inputs change.
# Default: discobox-sandbox-agent:local
# DISCOBOX_DEFAULT_SANDBOX_IMAGE=discobox-sandbox-agent:local
# DISCOBOX_DEFAULT_SANDBOX_IMAGE_DIGEST=

# Included harness images
# task dev updates these automatically when each harness image changes.
# DISCOBOX_HARNESS_CODEX_IMAGE=discobox-harness-codex:local
# DISCOBOX_HARNESS_CLAUDE_CODE_IMAGE=discobox-harness-claude-code:local
