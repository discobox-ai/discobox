# Disco2 discobot-server
# Copy this file to .env and adjust as needed.
#
# Usage: cp .env.example .env
#
# XDG Base Directory Compliance:
# By default, the server stores data in XDG-compliant directories:
#   - Database: sqlite3://$XDG_DATA_HOME/disco2/disco2.db
#
# Override these with environment variables if needed.

# Server
PORT=8080

# Application directories
# DISCO2_DATA_DIR=
# DISCO2_CONFIG_DIR=
# DISCO2_CACHE_DIR=
# DISCO2_STATE_DIR=

# Database
# Default: sqlite3://$XDG_DATA_HOME/disco2/disco2.db
# DATABASE_DSN=sqlite3://./disco2.db
# DATABASE_READ_DSN=
# DATABASE_DRIVER=sqlite

# Jobs
# JOB_MAX_ATTEMPTS=3

# Secrets
# Base64-encoded 32-byte key used to encrypt secret database fields at rest.
# Generate this with internal/secrets.GenerateBase64Key from a trusted setup tool.
# DISCO2_ENCRYPTION_KEY=

# Dispatcher
# DISPATCHER_ENABLED=true
# DISPATCHER_POLL_INTERVAL=1s
# DISPATCHER_JOB_TIMEOUT=1m
# DISPATCHER_STALE_JOB_TIMEOUT=5m
# DISPATCHER_IMMEDIATE_EXECUTION=true
# DISPATCHER_DEFAULT_CONCURRENCY=1
# SANDBOX_RECONCILE_JOB_CONCURRENCY=4
