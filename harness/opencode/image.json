      "settings": [
        {
          "path": ".config/opencode/opencode.json",
          "format": "jsonc",
          "exclude": [
            "apiKey",
            "api_key",
            "provider.*.options.apiKey",
            "provider.*.options.headers",
            "mcp.*.environment",
            "mcp.*.headers",
            "mcp.*.oauth.clientSecret"
          ]
        },
        {
          "path": ".config/opencode/opencode.jsonc",
          "format": "jsonc",
          "exclude": [
            "apiKey",
            "api_key",
            "provider.*.options.apiKey",
            "provider.*.options.headers",
            "mcp.*.environment",
            "mcp.*.headers",
            "mcp.*.oauth.clientSecret"
          ]
        },
        {
          "path": ".config/opencode/config.json",
          "format": "jsonc",
          "exclude": [
            "apiKey",
            "api_key",
            "provider.*.options.apiKey",
            "provider.*.options.headers",
            "mcp.*.environment",
            "mcp.*.headers",
            "mcp.*.oauth.clientSecret"
          ]
        },
        {
          "path": ".config/opencode/cli.json",
          "format": "jsonc",
          "exclude": [
            "apiKey",
            "api_key",
            "provider.*.options.apiKey",
            "provider.*.options.headers",
            "mcp.*.environment",
            "mcp.*.headers",
            "mcp.*.oauth.clientSecret"
          ]
        },
        {
          "path": ".local/state/opencode/model.json",
          "format": "json",
          "createOnly": true,
          "exclude": [
            "recent"
          ]
        },
        {
          "path": ".config/discobox/opencode-harness.json",
          "format": "json",
          "exclude": [
            "about"
          ]
        }
      ],
      "credentialFiles": [
        ".config/discobox/opencode-credentials.json"
      ],
      "credentialSettings": [
        {
          "path": ".config/discobox/opencode-credentials.json",
          "format": "json",
          "fields": {
            "*.id": "string",
            "*.integrationID": "string",
            "*.active": "boolean",
            "*.label": "string",
            "*.value.type": "string",
            "*.value.key": "secret",
            "*.value.access": "secret-or-placeholder",
            "*.value.refresh": "secret-or-placeholder",
            "*.value.expires": "number",
            "*.value.accountId": "string",
            "*.value.email": "string",
            "*.value.projectId": "string",
            "*.value.methodID": "string",
            "*.value.metadata.accountID": "string",
            "*.value.metadata.email": "string"
          }
        }
      ]
