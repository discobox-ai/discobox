{
  "apiVersion": "discobox.dev/image/v1",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "env": {
    "COPILOT_ALLOW_ALL": "true",
    "COPILOT_AUTO_UPDATE": "false"
  },
  "harness": {
    "id": "copilot",
    "name": "GitHub Copilot",
    "description": "GitHub Copilot CLI coding harness.",
    "secrets": [
      {
        "name": "COPILOT_GITHUB_TOKEN",
        "required": true,
        "routes": [
          {
            "hosts": [
              "*.githubcopilot.com",
              "githubcopilot.com"
            ]
          },
          {
            "hosts": [
              "*.githubcopilot.com",
              "githubcopilot.com"
            ],
            "paths": [
              "/agents/swe/internal/memory/**",
              "/mcp/readonly/**",
              "/v1/messages/**"
            ]
          },
          {
            "hosts": [
              "*.api.github.com",
              "api.github.com"
            ],
            "paths": [
              "/copilot_internal/**",
              "/repos/github/copilot-cli/releases/**"
            ]
          },
          {
            "hosts": [
              "*.githubcopilot.com",
              "githubcopilot.com"
            ],
            "paths": [
              "/agents/**",
              "/mcp/**"
            ],
            "blocked": true
          },
          {
            "hosts": [
              "*.github.com",
              "github.com"
            ],
            "blocked": true
          }
        ]
      }
    ],
    "config": {
      "reminder": "Sign in, optionally set the default model with /config model, then finish configuration with /exit.",
      "ports": [
        {
          "ephemeral": true,
          "unavailable": "Copilot's browser sign-in can finish only if its callback port is free on your machine; if it is not, run /login again for another port, or choose \"Sign in with a device code\"."
        }
      ],
      "command": [
        "/usr/local/libexec/discobox/configure-copilot"
      ]
    },
    "saveBack": {
      "version": 1,
      "watch": [
        ".copilot/settings.json",
        ".copilot/config.json"
      ],
      "exportCommand": [
        "/usr/local/libexec/discobox/copilot-capture",
        "export"
      ],
      "handoffCommand": [
        "/usr/local/libexec/discobox/copilot-capture",
        "handoff"
      ],
      "providers": [
        {
          "id": "github",
          "envName": "COPILOT_GITHUB_TOKEN",
          "types": [
            "token"
          ],
          "routes": [
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ]
            },
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ],
              "paths": [
                "/agents/swe/internal/memory/**",
                "/mcp/readonly/**",
                "/v1/messages/**"
              ]
            },
            {
              "hosts": [
                "*.api.github.com",
                "api.github.com"
              ],
              "paths": [
                "/copilot_internal/**",
                "/repos/github/copilot-cli/releases/**"
              ]
            },
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ],
              "paths": [
                "/agents/**",
                "/mcp/**"
              ],
              "blocked": true
            },
            {
              "hosts": [
                "*.github.com",
                "github.com"
              ],
              "blocked": true
            }
          ]
        }
      ],
      "settings": [
        {
          "path": ".copilot/settings.json",
          "format": "jsonc",
          "exclude": [
            "apiKey",
            "api_key",
            "authTokens",
            "lastLoggedInUser",
            "env",
            "mcpServers.*.env",
            "mcpServers.*.headers",
            "storeTokenPlaintext"
          ]
        }
      ],
      "credentialFiles": [
        ".copilot/config.json"
      ],
      "credentialSettings": []
    }
  }
}
