{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event sessionStart", "timeoutSec": 3 }],
    "sessionEnd": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event sessionEnd", "timeoutSec": 3 }],
    "userPromptSubmitted": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event userPromptSubmitted", "timeoutSec": 3 }],
    "userPromptTransformed": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event userPromptTransformed", "timeoutSec": 3 }],
    "preToolUse": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event preToolUse", "timeoutSec": 3 }],
    "preMcpToolCall": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event preMcpToolCall", "timeoutSec": 3 }],
    "permissionRequest": [{ "type": "command", "bash": "discobox-hook-publish --provider copilot --event permissionRequest", "timeoutSec": 3 }],
