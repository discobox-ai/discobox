{
  "apiVersion": "discobox.dev/image/v1",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "harness": {
    "id": "codex",
    "name": "Codex",
    "description": "OpenAI Codex coding harness.",
    "files": [],
    "secrets": [
      {
        "name": "OPENAI_API_KEY",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file"
      },
      {
        "name": "CODEX_OAUTH_TOKEN",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file"
      }
    ],
    "config": {
      "reminder": "Sign in with /login, then finish configuration with /exit.",
      "ports": [
        {
          "port": 1455,
          "unavailable": "Port 1455 is taken on your machine, so \"Sign in with ChatGPT\" cannot complete here. Choose \"Sign in with Device Code\" instead, or free the port and configure again."
        }
      ],
      "command": [
        "/usr/local/libexec/discobox/configure-codex"
      ]
    },
    "saveBack": {
      "version": 1,
      "watch": [
        ".codex/config.toml",
        ".codex/auth.json"
      ],
      "exportCommand": [
        "/usr/local/libexec/discobox/codex-capture",
        "export"
      ],
      "handoffCommand": [
        "/usr/local/libexec/discobox/codex-capture",
        "handoff"
      ],
      "providers": [
        {
          "id": "openai-key",
          "envName": "OPENAI_API_KEY",
          "types": [
            "token"
          ],
          "host": "api.openai.com"
        },
        {
          "id": "openai",
          "envName": "CODEX_OAUTH_TOKEN",
          "types": [
            "oauth"
          ],
          "oauth": {
            "tokenUrl": "https://auth.openai.com/oauth/token",
            "clientId": "app_EMoamEEZ73f0CkXaXp7hrann"
          }
        }
      ],
      "settings": [
        {
          "path": ".codex/config.toml",
          "format": "toml",
          "exclude": [
            "projects",
            "api_key",
            "model_providers.*.api_key",
            "model_providers.*.experimental_bearer_token",
            "model_providers.*.http_headers",
            "mcp_servers.*.env",
            "mcp_servers.*.http_headers",
            "mcp_servers.*.bearer_token",
            "shell_environment_policy.set",
            "profiles.*.shell_environment_policy.set",
            "mcp_servers.*.oauth.client_secret",
            "profiles.*.mcp_servers.*.oauth.client_secret",
            "model_providers.*.auth",
            "profiles.*.model_providers.*.auth"
          ]
        }
      ],
      "credentialFiles": [
        ".codex/auth.json"
      ],
      "credentialSettings": [
        {
          "path": ".codex/auth.json",
          "format": "json",
          "fields": {
            "OPENAI_API_KEY": "secret-or-null",
            "tokens.access_token": "secret",
            "tokens.refresh_token": "placeholder",
            "tokens.id_token": "id-token",
            "tokens.account_id": "string",
            "last_refresh": "string"
          }
        }
      ]
    }
  }
}
