{
  "apiVersion": "discobox.dev/image/v1",
  "env": {
    "CLAUDE_CODE_TMPDIR": "/var/lib/claude-code",
    "DISABLE_AUTOUPDATER": "1"
  },
  "volumes": [
    { "path": "/var/lib/claude-code", "volume": "data", "uid": "%UID%", "gid": "%GID%", "mode": "0700" }
  ],
  "harness": {
    "id": "claude-code",
    "name": "Claude Code",
    "description": "Anthropic Claude Code coding harness.",
    "files": [
      {
        "path": ".claude.json",
        "createOnly": true,
        "template": true,
        "content": "{\n  \"hasCompletedOnboarding\": true\n  {{- if .secrets.ANTHROPIC_API_KEY }},\n  \"primaryApiKey\": {{ .secrets.ANTHROPIC_API_KEY | json }}\n  {{- end }},\n  \"projects\": {\n    {{ .workingDir | json }}: {\n      \"hasTrustDialogAccepted\": true\n    }\n  }\n}"
      },
      {
        "path": ".claude/settings.json",
        "content": "{\"theme\":\"dark\",\"skipDangerousModePermissionPrompt\":true,\"permissions\":{\"defaultMode\":\"bypassPermissions\"}}"
      }
    ],
    "secrets": [
      {
        "name": "ANTHROPIC_API_KEY",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file"
      },
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file"
      }
    ],
    "config": {
      "reminder": "Run /login, optionally adjust /model and /config, then finish configuration with /exit.",
      "command": [
        "/usr/local/libexec/discobox/configure-claude-code"
      ]
    }
  }
}
