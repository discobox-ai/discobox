{
  "schema": 1,
  "id": "claude-code",
  "bundle": "discobox-harness-claude-code",
  "name": "Claude Code",
  "description": "Anthropic Claude Code coding harness.",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "install": {
    "requires": [
      "core",
      "node"
    ],
    "package": "@anthropic-ai/claude-code",
    "executable": "claude"
  },
  "launch": {
    "resume": [
      "--continue"
    ],
    "prompt": {
      "form": "positional"
    }
  },
  "environment": {
    "static": {
      "CLAUDE_CODE_TMPDIR": "/var/lib/claude-code",
      "DISABLE_AUTOUPDATER": "1",
      "DISABLE_ERROR_REPORTING": "1",
      "DISABLE_FEEDBACK_COMMAND": "1",
      "DISABLE_TELEMETRY": "1",
      "FORCE_HYPERLINK": "1"
    },
    "volumes": [
      {
        "path": "/var/lib/claude-code",
        "volume": "data",
        "uid": "%UID%",
        "gid": "%GID%",
        "mode": "0700"
      }
    ]
  },
  "settings": {
    "files": [
      {
        "path": ".claude/settings.json",
        "content": "{\"theme\":\"dark\",\"disableClaudeAiConnectors\":true,\"skipDangerousModePermissionPrompt\":true,\"permissions\":{\"defaultMode\":\"bypassPermissions\"}}"
      }
    ]
  },
  "localState": {
    "trust": {
      "strategy": "local-state"
    },
    "memory": {
      "strategy": "managed-setting",
      "name": "claude-code",
      "path": "/etc/claude-code/managed-settings.d/discobox-memory.json",
      "key": "autoMemoryDirectory"
    }
  },
  "credentials": {
    "secrets": [
      {
        "name": "ANTHROPIC_API_KEY",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file",
        "rejectionScope": [
          {
            "host": "api.anthropic.com",
            "paths": [
              "/v1/messages"
            ]
          }
        ],
        "routes": [
          {
            "hosts": [
              "api.anthropic.com"
            ]
          }
        ]
      },
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "required": true,
        "oneOfGroup": "auth",
        "delivery": "file",
        "rejectionScope": [
          {
            "host": "api.anthropic.com",
            "paths": [
              "/v1/messages"
            ]
          }
        ],
        "routes": [
          {
            "hosts": [
              "api.anthropic.com",
              "claude.ai",
              "mcp-proxy.anthropic.com"
            ]
          }
        ]
      }
    ],
    "egressHosts": [
      "api.anthropic.com",
      "claude.ai",
      "platform.claude.com",
      "mcp-proxy.anthropic.com"
    ],
    "store": {
      "strategy": "file",
      "document": ".claude/.credentials.json"
    }
  },
  "hooks": {
    "provider": "claude-code",
    "transport": "command",
    "format": "claude-code",
    "path": "/etc/claude-code/managed-settings.json",
    "timeout": 10,
    "events": [
      "SessionStart",
      "Setup",
      "InstructionsLoaded",
      "UserPromptSubmit",
      "UserPromptExpansion",
      "MessageDisplay",
      "PreToolUse",
      "PermissionRequest",
      "PostToolUse",
      "PostToolUseFailure",
      "PostToolBatch",
      "PermissionDenied",
      "Notification",
      "SubagentStart",
      "SubagentStop",
      "TaskCreated",
      "TaskCompleted",
      "Stop",
      "StopFailure",
      "TeammateIdle",
      "ConfigChange",
      "CwdChanged",
      "DirectoryAdded",
      "FileChanged",
      "WorktreeCreate",
      "WorktreeRemove",
      "PreCompact",
      "PostCompact",
      "PreModelSwitch",
      "PostModelSwitch",
      "SessionEnd",
      "Elicitation",
      "ElicitationResult"
    ]
  },
  "capture": {
    "version": 1,
    "watch": [
      ".claude/settings.json",
      ".claude/.credentials.json",
      ".claude.json"
    ],
    "providers": [
      {
        "id": "anthropic-key",
        "envName": "ANTHROPIC_API_KEY",
        "types": [
          "token"
        ],
        "host": "api.anthropic.com",
        "routes": [
          {
            "hosts": [
              "api.anthropic.com"
            ]
          }
        ]
      },
      {
        "id": "anthropic",
        "envName": "CLAUDE_CODE_OAUTH_TOKEN",
        "types": [
          "oauth"
        ],
        "oauth": {
          "tokenUrl": "https://console.anthropic.com/v1/oauth/token",
          "clientId": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
        },
        "host": "api.anthropic.com",
        "routes": [
          {
            "hosts": [
              "api.anthropic.com",
              "claude.ai",
              "mcp-proxy.anthropic.com"
            ]
          }
        ]
      }
    ],
    "settings": [
      {
        "path": ".claude/settings.json",
        "format": "json",
        "exclude": [
          "apiKey",
          "api_key",
          "primaryApiKey",
          "claudeAiOauth",
          "env",
          "apiKeyHelper"
        ]
      }
    ],
    "credentialFiles": [
      ".claude/.credentials.json",
      ".claude.json"
    ],
    "credentialSettings": [
      {
        "path": ".claude/.credentials.json",
        "format": "json",
        "fields": {
          "claudeAiOauth.accessToken": "secret",
          "claudeAiOauth.refreshToken": "placeholder",
          "claudeAiOauth.expiresAt": "number",
          "claudeAiOauth.scopes": "string-array",
          "claudeAiOauth.subscriptionType": "string"
        }
      },
      {
        "path": ".claude.json",
        "format": "json",
        "fields": {
          "primaryApiKey": "secret",
          "hasCompletedOnboarding": "boolean"
        }
      }
    ]
  }
}
