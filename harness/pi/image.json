{
  "apiVersion": "discobox.dev/image/v1",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "env": {
    "PI_SKIP_VERSION_CHECK": "1",
    "PI_TELEMETRY": "0",
    "PI_CLIPBOARD_OSC52": "1"
  },
  "harness": {
    "id": "pi",
    "name": "pi",
    "description": "pi coding harness, with any provider it signs in to.",
    "files": [
      {
        "path": ".pi/agent/extensions/discobox-hooks.js",
        "content": "// Discobox's hooks for pi, installed with the image. Removing this file stops them.\nexport { default } from \"/usr/local/libexec/discobox/pi-hook-extension.js\";\n"
      },
      {
        "path": ".config/discobox/pi-harness.json",
        "content": "{\n  \"about\": \"Discobox's settings for the pi harness. Edit with: discobox admin harness edit pi .config/discobox/pi-harness.json\",\n  \"judgeModel\": \"\"\n}\n"
      }
    ],
    "config": {
      "reminder": "Sign in with /login, pick a default model with /model, then finish configuration with /quit.",
      "ports": [
        {
          "port": 53692,
          "unavailable": "Port 53692 is taken on your machine, so Anthropic's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into pi, or sign in with an API key."
        },
        {
          "port": 1455,
          "unavailable": "Port 1455 is taken on your machine, so OpenAI's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into pi, or sign in with an API key."
        },
        {
          "port": 1456,
          "unavailable": "Port 1456 is taken on your machine, so Radius's browser sign-in cannot call back here. In /login choose Radius's device-code sign-in instead, or free the port and configure again."
        },
        {
          "ephemeral": true,
          "unavailable": "OpenRouter's browser sign-in calls back to a port pi picks fresh, and the one it picked is taken on your machine. After you authorize, copy the address your browser lands on and paste it into pi, or sign in with an OpenRouter API key."
        }
      ],
      "command": [
        "/usr/local/libexec/discobox/configure-pi"
      ]
    },
    "saveBack": {
      "version": 1,
      "watch": [
        ".pi/agent/settings.json",
        ".pi/agent/keybindings.json",
        ".config/discobox/pi-harness.json",
        ".pi/agent/auth.json"
      ],
      "exportCommand": [
        "/usr/local/libexec/discobox/pi-capture",
        "export"
      ],
      "handoffCommand": [
        "/usr/local/libexec/discobox/pi-capture",
        "handoff"
      ],
      "providers": [
        {
          "id": "anthropic",
          "envName": "PI_ANTHROPIC_CREDENTIAL",
          "types": [
            "token",
            "oauth"
          ],
          "oauth": {
            "tokenUrl": "https://console.anthropic.com/v1/oauth/token",
            "clientId": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
          }
        },
        {
          "id": "openai",
          "envName": "PI_OPENAI_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "google",
          "envName": "PI_GOOGLE_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "google-vertex",
          "envName": "PI_GOOGLE_VERTEX_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "groq",
          "envName": "PI_GROQ_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "mistral",
          "envName": "PI_MISTRAL_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "openrouter",
          "envName": "PI_OPENROUTER_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "xai",
          "envName": "PI_XAI_CREDENTIAL",
          "types": [
            "token",
            "oauth"
          ],
          "oauth": {
            "tokenUrl": "https://auth.x.ai/oauth2/token",
            "clientId": "b1a00492-073a-47ea-816f-4c329264a828",
            "encoding": "form"
          }
        },
        {
          "id": "github-copilot",
          "envName": "PI_GITHUB_COPILOT_CREDENTIAL",
          "types": [
            "token"
          ],
          "host": "api.github.com"
        },
        {
          "id": "deepseek",
          "envName": "PI_DEEPSEEK_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "cerebras",
          "envName": "PI_CEREBRAS_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "zai",
          "envName": "PI_ZAI_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "kimi-coding",
          "envName": "PI_KIMI_CODING_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "minimax",
          "envName": "PI_MINIMAX_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "huggingface",
          "envName": "PI_HUGGINGFACE_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "azure",
          "envName": "PI_AZURE_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "amazon-bedrock",
          "envName": "PI_AMAZON_BEDROCK_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "google-gemini-cli",
          "envName": "PI_GOOGLE_GEMINI_CLI_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "google-antigravity",
          "envName": "PI_GOOGLE_ANTIGRAVITY_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "openai-codex",
          "envName": "PI_OPENAI_CODEX_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "xai-oauth",
          "envName": "PI_XAI_OAUTH_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "alibaba",
          "envName": "PI_ALIBABA_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "togetherai",
          "envName": "PI_TOGETHERAI_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "fireworks-ai",
          "envName": "PI_FIREWORKS_AI_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "perplexity",
          "envName": "PI_PERPLEXITY_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "cohere",
          "envName": "PI_COHERE_CREDENTIAL",
          "types": [
            "token"
          ]
        },
        {
          "id": "opencode",
          "envName": "PI_OPENCODE_CREDENTIAL",
          "types": [
            "token"
          ]
        }
      ],
      "settings": [
        {
          "path": ".pi/agent/settings.json",
          "format": "json",
          "fields": {
            "defaultProvider": "string",
            "defaultModel": "string",
            "defaultThinkingLevel": "string",
            "theme": "string",
            "hideThinkingBlock": "boolean",
            "compaction.enabled": "boolean",
            "compaction.reserveTokens": "number",
            "compaction.keepRecentTokens": "number"
          }
        },
        {
          "path": ".pi/agent/keybindings.json",
          "format": "json",
          "fields": {
            "app.interrupt": "string-array",
            "app.exit": "string-array",
            "app.suspend": "string-array",
            "app.model.select": "string-array"
          }
        },
        {
          "path": ".config/discobox/pi-harness.json",
          "format": "json",
          "fields": {
            "judgeModel": "string"
          }
        }
      ],
      "credentialFiles": [
        ".pi/agent/auth.json"
      ],
      "credentialSettings": [
        {
          "path": ".pi/agent/auth.json",
          "format": "json",
          "fields": {
            "*.type": "string",
            "*.key": "secret",
            "*.access": "secret-or-placeholder",
            "*.refresh": "secret-or-placeholder",
            "*.expires": "number",
            "*.accountId": "string",
            "*.email": "string",
            "*.projectId": "string",
            "*.methodID": "string"
          }
        }
      ]
    }
  }
}
