        },
        {
          "id": "fireworks-ai",
          "envName": "OMP_FIREWORKS_AI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "perplexity",
          "envName": "OMP_PERPLEXITY_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "cohere",
          "envName": "OMP_COHERE_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "opencode",
          "envName": "OMP_OPENCODE_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        }
      ],
      "settings": [
        {
          "path": ".omp/agent/config.yml",
          "format": "yaml",
          "exclude": [
            "apiKey",
            "api_key",
            "providers.*.apiKey",
            "providers.*.headers",
            "mcpServers.*.env",
            "mcpServers.*.headers"
          ]
        },
        {
          "path": ".config/discobox/omp-harness.json",
          "format": "json",
          "exclude": [
            "about"
          ]
        }
      ],
      "credentialFiles": [
        ".config/discobox/omp-credentials.json"
      ],
      "credentialSettings": [
        {
          "path": ".config/discobox/omp-credentials.json",
          "format": "json",
          "fields": {
            "version": "number",
            "credentials.*.provider": "string",
            "credentials.*.credential.type": "string",
            "credentials.*.credential.key": "secret",
            "credentials.*.credential.access": "secret-or-placeholder",
            "credentials.*.credential.refresh": "secret-or-placeholder",
            "credentials.*.credential.expires": "number",
            "credentials.*.credential.accountId": "string",
            "credentials.*.credential.email": "string",
            "credentials.*.credential.projectId": "string",
            "credentials.*.credential.methodID": "string"
          }
        }
      ]
    }
  }
}
