{
  "apiVersion": "discobox.dev/image/v1",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "env": {
    "PI_CONFIG_FILES": "/etc/omp/discobox.yml",
    "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip"
  },
  "harness": {
    "id": "omp",
    "name": "omp",
    "description": "omp (oh-my-pi) coding harness, with any provider it signs in to.",
    "files": [
      {
        "path": ".omp/agent/extensions/discobox-hooks.js",
        "content": "// Discobox's hooks for omp, installed with the image. Removing this file stops them.\nexport { default } from \"/usr/local/libexec/discobox/omp-hook-extension.js\";\n"
      },
      {
        "path": ".config/discobox/omp-harness.json",
        "content": "{\n  \"about\": \"Discobox's settings for the omp harness. Edit with: discobox admin harness edit omp .config/discobox/omp-harness.json\",\n  \"judgeModel\": \"\"\n}\n"
      }
    ],
    "config": {
      "reminder": "Sign in with /login, pick a default model with /model, then finish configuration with /exit.",
      "ports": [
        {
          "port": 1455,
          "unavailable": "Port 1455 is taken on your machine, so ChatGPT's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into omp, or free the port and configure again."
        },
        {
          "port": 54545,
          "unavailable": "Port 54545 is taken on your machine, so Anthropic's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into omp, or free the port and configure again."
        },
        {
          "port": 8085,
          "unavailable": "Port 8085 is taken on your machine, so Gemini CLI's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into omp, or free the port and configure again."
        },
        {
          "port": 51121,
          "unavailable": "Port 51121 is taken on your machine, so Antigravity's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into omp, or free the port and configure again."
        },
        {
          "port": 54549,
          "unavailable": "Port 54549 is taken on your machine, so OpenRouter's browser sign-in cannot call back here. After you authorize, copy the address your browser lands on and paste it into omp, or free the port and configure again."
        }
      ],
      "command": [
        "/usr/local/libexec/discobox/configure-omp"
      ]
    },
    "saveBack": {
      "version": 1,
      "watch": [
        ".omp/agent/config.yml",
        ".config/discobox/omp-harness.json",
        ".config/discobox/omp-credentials.json",
        ".omp/agent/agent.db",
        ".omp/agent/agent.db-wal"
      ],
      "exportCommand": [
        "/usr/local/libexec/discobox/omp-capture",
        "export"
      ],
      "handoffCommand": [
        "/usr/local/libexec/discobox/omp-capture",
        "handoff"
      ],
      "providers": [
        {
          "id": "anthropic",
          "envName": "OMP_ANTHROPIC_CREDENTIAL",
          "types": [
            "token",
            "oauth"
          ],
          "oauth": {
            "tokenUrl": "https://console.anthropic.com/v1/oauth/token",
            "clientId": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
          },
          "multipleAccounts": true
        },
        {
          "id": "openai",
          "envName": "OMP_OPENAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "google",
          "envName": "OMP_GOOGLE_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "google-vertex",
          "envName": "OMP_GOOGLE_VERTEX_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "groq",
          "envName": "OMP_GROQ_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "mistral",
          "envName": "OMP_MISTRAL_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "openrouter",
          "envName": "OMP_OPENROUTER_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "xai",
          "envName": "OMP_XAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "github-copilot",
          "envName": "OMP_GITHUB_COPILOT_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "deepseek",
          "envName": "OMP_DEEPSEEK_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "cerebras",
          "envName": "OMP_CEREBRAS_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "zai",
          "envName": "OMP_ZAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "kimi-coding",
          "envName": "OMP_KIMI_CODING_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "minimax",
          "envName": "OMP_MINIMAX_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true
        },
        {
          "id": "huggingface",
          "envName": "OMP_HUGGINGFACE_CREDENTIAL",
          "types": [
            "token"
          ],
