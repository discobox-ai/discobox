{
  "apiVersion": "discobox.dev/image/v1",
  "platformAPIVersion": "discobox.ai/platform/v1",
  "env": {
    "PI_CONFIG_FILES": "/etc/omp/discobox.yml",
    "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip"
  },
  "harness": {
    "id": "omp",
    "name": "omp",
    "description": "omp (oh-my-pi) coding harness, with any provider it signs in to.",
    "files": [
      {
        "path": ".omp/agent/extensions/discobox-hooks.js",
        "content": "// Discobox's hooks for omp, installed with the image. Removing this file stops them.\nexport { default } from \"/usr/local/libexec/discobox/omp-hook-extension.js\";\n"
      }
    ],
    "saveBack": {
      "version": 1,
      "watch": [
        ".omp/agent/config.yml",
        ".config/discobox/omp-harness.json",
        ".config/discobox/omp-credentials.json",
        ".omp/agent/agent.db",
        ".omp/agent/agent.db-wal"
      ],
      "exportCommand": [
        "/usr/local/libexec/discobox/omp-capture",
        "export"
      ],
      "handoffCommand": [
        "/usr/local/libexec/discobox/omp-capture",
        "handoff"
      ],
      "providers": [
        {
          "id": "anthropic",
          "envName": "OMP_ANTHROPIC_CREDENTIAL",
          "types": [
            "token",
            "oauth"
          ],
          "oauth": {
            "tokenUrl": "https://console.anthropic.com/v1/oauth/token",
            "clientId": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
          },
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.anthropic.com"
              ]
            }
          ]
        },
        {
          "id": "openai",
          "envName": "OMP_OPENAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.openai.com"
              ]
            }
          ]
        },
        {
          "id": "google",
          "envName": "OMP_GOOGLE_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "generativelanguage.googleapis.com"
              ]
            }
          ]
        },
        {
          "id": "google-vertex",
          "envName": "OMP_GOOGLE_VERTEX_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "manualRoutes": "This provider uses account, region or deployment-specific endpoints. Create a secret with explicit endpoint routes and bind it to the harness config."
        },
        {
          "id": "groq",
          "envName": "OMP_GROQ_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.groq.com"
              ]
            }
          ]
        },
        {
          "id": "mistral",
          "envName": "OMP_MISTRAL_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.mistral.ai"
              ]
            }
          ]
        },
        {
          "id": "openrouter",
          "envName": "OMP_OPENROUTER_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "openrouter.ai"
              ]
            }
          ]
        },
        {
          "id": "xai",
          "envName": "OMP_XAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.x.ai"
              ]
            }
          ]
        },
        {
          "id": "github-copilot",
          "envName": "OMP_GITHUB_COPILOT_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ]
            },
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ],
              "paths": [
                "/agents/swe/internal/memory/**",
                "/mcp/readonly/**",
                "/v1/messages/**"
              ]
            },
            {
              "hosts": [
                "*.api.github.com",
                "api.github.com"
              ],
              "paths": [
                "/copilot_internal/**",
                "/repos/github/copilot-cli/releases/**"
              ]
            },
            {
              "hosts": [
                "*.githubcopilot.com",
                "githubcopilot.com"
              ],
              "paths": [
                "/agents/**",
                "/mcp/**"
              ],
              "blocked": true
            },
            {
              "hosts": [
                "*.github.com",
                "github.com"
              ],
              "blocked": true
            }
          ]
        },
        {
          "id": "deepseek",
          "envName": "OMP_DEEPSEEK_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.deepseek.com"
              ]
            }
          ]
        },
        {
          "id": "cerebras",
          "envName": "OMP_CEREBRAS_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.cerebras.ai"
              ]
            }
          ]
        },
        {
          "id": "zai",
          "envName": "OMP_ZAI_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.z.ai"
              ]
            }
          ]
        },
        {
          "id": "kimi-coding",
          "envName": "OMP_KIMI_CODING_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.kimi.com"
              ]
            }
          ]
        },
        {
          "id": "minimax",
          "envName": "OMP_MINIMAX_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "api.minimax.io"
              ]
            }
          ]
        },
        {
          "id": "huggingface",
          "envName": "OMP_HUGGINGFACE_CREDENTIAL",
