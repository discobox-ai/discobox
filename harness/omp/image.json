          ],
          "multipleAccounts": true,
          "routes": [
            {
              "hosts": [
                "router.huggingface.co"
              ]
            }
          ]
        },
        {
          "id": "azure",
          "envName": "OMP_AZURE_CREDENTIAL",
          "types": [
            "token"
          ],
          "multipleAccounts": true,
          "manualRoutes": "This provider uses account, region or deployment-specific endpoints. Create a secret with explicit endpoint routes and bind it to the harness config."
        },
        {
          "id": "amazon-bedrock",
          "envName": "OMP_AMAZON_BEDROCK_CREDENTIAL",
          "types": [
            "token"
          ],
