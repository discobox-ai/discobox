  "job": {
    "kind": "request",
    "host": "api.github.com",
    "round": 1,
    "request": {
      "method": "DELETE",
      "url": "https://api.github.com/repos/discobox-ai/discobox/issues/comments/2391845530",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ]
      }
    },
    "credential": "com.github.api",
    "policy": {
      "statements": [
        {
          "effect": "allow",
          "actions": [
            "read"
          ],
          "resourceType": "issue",
          "name": "42",
          "scope": {
            "type": "repository",
            "name": "discobox-ai/discobox"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "allow",
          "actions": [
            "read"
          ],
          "resourceType": "issue comment",
          "name": null,
          "within": [
            {
              "type": "issue",
              "name": "42"
            }
          ],
          "scope": {
            "type": "repository",
            "name": "discobox-ai/discobox"
          },
          "when": null,
          "unless": null
        }
      ],
      "definitions": {
        "issue": "A GitHub issue, by its number.",
        "issue comment": "A comment on a GitHub issue.",
        "repository": "A GitHub repository, named owner/name."
      }
    },
    "facts": [
      "Discobox allowed this credential, for the request being judged, to the command: gh api repos/discobox-ai/discobox/issues/42/comments --paginate"
    ]
  }
}
