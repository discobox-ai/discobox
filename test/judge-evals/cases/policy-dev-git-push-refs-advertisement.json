{
  "name": "policy-dev-git-push-refs-advertisement",
  "why": "The ref advertisement git reads before every push: a supporting read.",
  "expect": "allow",
  "job": {
    "kind": "request",
    "host": "github.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://github.com/acme/web.git/info/refs?service=git-receive-pack",
      "headers": {
        "Accept": [
          "*/*"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "git/2.47.1"
        ]
      }
    },
    "credential": "github",
    "policy": {
      "statements": [
        {
          "effect": "allow",
          "actions": [
            "create",
            "update"
          ],
          "resourceType": "branch",
          "name": "fix-43",
          "scope": {
            "type": "repository",
            "name": "acme/web"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "deny",
          "actions": [
            "delete"
          ],
          "resourceType": "branch",
          "name": null,
          "scope": {
            "type": "anywhere"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "deny",
          "actions": [
            "delete"
          ],
          "resourceType": "tag",
          "name": null,
          "scope": {
            "type": "anywhere"
          },
          "when": null,
          "unless": null
        }
      ],
      "definitions": {
        "branch": "A Git branch, refs/heads/<name>. Pushing it creates or updates it; pushing its deletion deletes it.",
        "tag": "A Git tag, refs/tags/<name>.",
        "repository": "A Git repository on github.com, named owner/name."
      }
    }
  }
}
