{
  "name": "policy-supporting-not-actions-secrets",
  "why": "Control: listing Actions secrets is a read in the allowed repository but no step toward reading its workflow runs, and no deny is needed to refuse it.",
  "expect": "refuse",
  "job": {
    "kind": "request",
    "host": "api.github.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://api.github.com/repos/acme/web/actions/secrets",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ]
      }
    },
    "credential": "com.github.api",
    "policy": {
      "statements": [
        {
          "effect": "allow",
          "actions": [
            "read"
          ],
          "resourceType": "workflow run",
          "name": null,
          "scope": {
            "type": "repository",
            "name": "acme/web"
          },
          "when": null,
          "unless": null
        }
      ],
      "definitions": {
        "workflow run": "A GitHub Actions workflow run, with its jobs and their status.",
        "repository": "A GitHub repository, named owner/name."
      }
    }
  }
}
