{
  "name": "facts-create-an-issue-in-this-discoboxs-repository-unstated",
  "why": "Control: the same use and request with no facts, so nothing says acme/web is the discobox's repository.",
  "expect": "refuse",
  "job": {
    "kind": "request",
    "purpose": "create issues for the primary source of this discobox",
    "host": "api.github.com",
    "credential": "com.github.api",
    "round": 2,
    "request": {
      "method": "POST",
      "url": "https://api.github.com/repos/acme/web/issues",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ],
        "Content-Type": [
          "application/json"
        ],
        "Content-Length": [
          "105"
        ]
      },
      "body": {
        "mediaType": "application/json",
        "length": 105,
        "parser": {
          "name": "json",
          "version": 1
        },
        "metadata": {
          "keys": [
            "body",
            "title"
          ]
        },
        "content": "{\"title\":\"Flaky TestPoolDrain on arm64\",\"body\":\"Fails about one run in ten; log attached in CI run 812.\"}"
      }
    }
  },
  "policy": {
    "statements": [
      "allow create on issue in repository $primary.repo"
    ],
    "definitions": {
      "issue": "A GitHub issue.",
      "repository": "A GitHub repository, owner/name."
    }
  }
}
