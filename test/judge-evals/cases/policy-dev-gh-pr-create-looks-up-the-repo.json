{
  "name": "policy-dev-gh-pr-create-looks-up-the-repo",
  "why": "gh pr create reads the repository first, under the policy's read of the primary repository.",
  "expect": "allow",
  "job": {
    "kind": "request",
    "host": "api.github.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://api.github.com/repos/acme/web",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ]
      }
    },
    "credential": "com.github.api",
    "policy": {
      "statements": [
        {
          "effect": "allow",
          "actions": [
            "create",
            "update"
          ],
          "resourceType": "pull request",
          "name": null,
          "scope": {
            "type": "repository",
            "name": "$primary.repo"
          },
          "when": "its head branch is fix-43 and its base branch is main",
          "unless": null
        },
        {
          "effect": "allow",
          "actions": [
            "read"
          ],
          "resourceType": "anything",
          "name": null,
          "scope": {
            "type": "repository",
            "name": "$primary.repo"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "deny",
          "actions": [
            "merge"
          ],
          "resourceType": "pull request",
          "name": null,
          "scope": {
            "type": "anywhere"
          },
          "when": null,
          "unless": null
        }
      ],
      "definitions": {
        "pull request": "A GitHub pull request, with its title, body, head and base.",
        "repository": "A GitHub repository, named owner/name.",
        "merge": "Merging a pull request into its base branch."
      },
      "resolved": {
        "$primary.repo": "acme/web"
      }
    },
    "variables": {
      "$primary.repo": "acme/web"
    },
    "facts": [
      "The discobox asking is sbx_7k2m4q9wfc3d8n1p.",
      "Its primary source, as it was created, is the Git repository github.com/acme/web, checked out from the branch fix-43."
    ]
  }
}
