{
  "name": "facts-rule-this-discoboxs-repository",
  "why": "A rule that says $primary.repo, resolved against what the asking discobox was created with (ADR 26-10-14-691): an ask naming that repository outright is within it.",
  "expect": "allow",
  "rule": {
    "policy": {
      "statements": [
        "allow create on issue in repository $primary.repo"
      ],
      "definitions": {
        "issue": "a GitHub issue",
        "repository": "a GitHub repository"
      }
    },
    "request": {
      "statements": [
        "allow create on issue in repository \"acme/web\""
      ],
      "definitions": {
        "issue": "a GitHub issue",
        "repository": "a GitHub repository"
      }
    },
    "facts": {
      "discobox": {
        "id": "sbx_6t1n8c3vqk2m9x4w",
        "project": "default"
      },
      "sources": [
        {
          "slug": "web",
          "primary": true,
          "remote": {
            "host": "github.com",
            "repo": "acme/web",
            "url": "https://github.com/acme/web"
          },
          "ref": {
            "type": "branch",
            "name": "main"
          }
        }
      ]
    },
    "credential": "com.github.api",
    "hosts": [
      "github.com"
    ]
  }
}
