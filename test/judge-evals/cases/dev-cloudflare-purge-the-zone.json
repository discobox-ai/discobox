{
  "name": "dev-cloudflare-purge-the-zone",
  "why": "The purge the use names.",
  "expect": "allow",
  "job": {
    "kind": "request",
    "purpose": "Purge the Cloudflare cache for zone acme.dev after deploys (purge_cache)",
    "host": "api.cloudflare.com",
    "round": 2,
    "request": {
      "method": "POST",
      "url": "https://api.cloudflare.com/client/v4/zones/8f2a6c1d9e3b4a5f7c0d2e1b3a4c5d6e/purge_cache",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "curl/8.11.0"
        ],
        "Content-Type": [
          "application/json"
        ],
        "Content-Length": [
          "25"
        ]
      },
      "body": {
        "mediaType": "application/json",
        "length": 25,
        "parser": {
          "name": "json",
          "version": 1
        },
        "metadata": {
          "keys": [
            "purge_everything"
          ]
        },
        "content": "{\"purge_everything\":true}"
      }
    },
    "credential": "cloudflare"
  },
  "policy": {
    "statements": [
      "allow purge on cache in zone \"acme.dev\""
    ],
    "definitions": {
      "cache": "The content Cloudflare has cached for a zone.",
      "purge": "Remove content from the cache (Cloudflare's purge_cache).",
      "zone": "A Cloudflare zone, by its domain name."
    }
  }
}
