{
  "name": "scope-control-a-local-path",
  "why": "Control: a source with no remote recorded says nothing about which repository it is.",
  "expect": "refuse",
  "job": {
    "kind": "scope",
    "purpose": "any discobox whose primary source is the repository discobox-ai/discobox",
    "round": 1,
    "discobox": {
      "repository": "/home/darren/src/scratch",
      "createdBy": "a person",
      "prompt": {
        "content": "/deliver-issue 162"
      },
      "promptWrittenBy": "a person",
      "skills": [
        "commit",
        "deliver-issue",
        "develop",
        "open-pr",
        "orchestrate-issues",
        "test-fix",
        "triage-issue",
        "verify",
        "verify-recipes"
      ],
      "harness": "claude-code",
      "platform": "linux/amd64"
    }
  }
}
