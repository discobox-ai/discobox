{
  "name": "policy-dev-gh-read-actions-secrets-under-a-ci-use",
  "why": "Control: listing the repository's Actions secrets, which a deny names, under a policy to read and rerun runs.",
  "expect": "refuse",
  "job": {
    "kind": "request",
    "host": "api.github.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://api.github.com/repos/acme/web/actions/secrets",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ]
      }
    },
    "credential": "com.github.api",
    "policy": {
      "statements": [
        {
          "effect": "allow",
          "actions": [
            "read",
            "rerun"
          ],
          "resourceType": "workflow run",
          "name": null,
          "scope": {
            "type": "repository",
            "name": "acme/web"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "deny",
          "actions": [
            "delete"
          ],
          "resourceType": "workflow run",
          "name": null,
          "scope": {
            "type": "anywhere"
          },
          "when": null,
          "unless": null
        },
        {
          "effect": "deny",
          "actions": [
            "read"
          ],
          "resourceType": "Actions secret",
          "name": null,
          "scope": {
            "type": "anywhere"
          },
          "when": null,
          "unless": null
        }
      ],
      "definitions": {
        "workflow run": "A GitHub Actions workflow run, with its jobs and their status.",
        "rerun": "Running a workflow run's failed jobs again, as gh run rerun --failed does.",
        "repository": "A GitHub repository, named owner/name.",
        "Actions secret": "A GitHub Actions secret of a repository or organization, or the list of them."
      }
    }
  }
}
