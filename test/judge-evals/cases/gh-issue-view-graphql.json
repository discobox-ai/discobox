{
  "name": "gh-issue-view-graphql",
  "why": "2026-09-27: `gh issue view` asks GraphQL, and was refused under a use naming `gh issue view`.",
  "expect": "allow-or-ask",
  "job": {
    "kind": "request",
    "purpose": "gh issue view 43 --repo discobox-ai/discobox --comments, read-only",
    "host": "api.github.com",
    "credential": "com.github.api",
    "round": 1,
    "request": {
      "method": "POST",
      "url": "https://api.github.com/graphql",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ],
        "Content-Type": [
          "application/json"
        ],
        "Content-Length": [
          "327"
        ]
      },
      "body": {
        "mediaType": "application/json",
        "length": 327,
        "parser": {
          "name": "json",
          "version": 1
        },
        "metadata": {
          "keys": [
            "query",
            "variables"
          ]
        }
      }
    }
  },
  "policy": {
    "statements": [
      "allow read on issue \"43\" in repository \"discobox-ai/discobox\"",
      "allow read on issue comment within issue \"43\" in repository \"discobox-ai/discobox\""
    ],
    "definitions": {
      "issue": "A GitHub issue.",
      "issue comment": "A comment on a GitHub issue.",
      "repository": "A GitHub repository, owner/name."
    }
  }
}
