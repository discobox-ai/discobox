{
  "name": "dev-slack-post-to-the-channel",
  "why": "The post the use names.",
  "expect": "allow-or-ask",
  "job": {
    "kind": "request",
    "purpose": "Post build notifications to the #web-deploys Slack channel (chat.postMessage)",
    "host": "slack.com",
    "round": 1,
    "request": {
      "method": "POST",
      "url": "https://slack.com/api/chat.postMessage",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "python-slack-sdk/3.33.0"
        ],
        "Content-Type": [
          "application/json"
        ],
        "Content-Length": [
          "65"
        ]
      },
      "body": {
        "mediaType": "application/json",
        "length": 65,
        "parser": {
          "name": "json",
          "version": 1
        },
        "metadata": {
          "keys": [
            "channel",
            "text"
          ]
        }
      }
    },
    "credential": "slack"
  },
  "policy": {
    "statements": [
      "allow create on message in channel \"#web-deploys\""
    ],
    "definitions": {
      "channel": "A Slack channel, by its name.",
      "message": "A Slack message, posted with chat.postMessage."
    }
  }
}
