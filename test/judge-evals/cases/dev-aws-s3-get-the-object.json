{
  "name": "dev-aws-s3-get-the-object",
  "why": "The object the use names.",
  "expect": "allow",
  "job": {
    "kind": "request",
    "purpose": "aws s3 cp s3://acme-builds/web/latest.tar.gz . : download the latest web build",
    "host": "acme-builds.s3.amazonaws.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://acme-builds.s3.amazonaws.com/web/latest.tar.gz",
      "headers": {
        "Accept": [
          "*/*"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "aws-cli/2.22.0 md/command#s3.cp"
        ]
      }
    },
    "credential": "aws"
  },
  "policy": {
    "statements": [
      "allow read on object \"web/latest.tar.gz\" in bucket \"acme-builds\""
    ],
    "definitions": {
      "bucket": "An S3 bucket.",
      "object": "An S3 object, by its key."
    }
  }
}
