{
  "name": "scope-control-another-repository",
  "why": "Control: the same work on another repository in the organization.",
  "expect": "refuse",
  "job": {
    "kind": "scope",
    "purpose": "any discobox whose primary source is the repository discobox-ai/discobox",
    "round": 1,
    "discobox": {
      "repository": "https://github.com/discobox-ai/hooks",
      "ref": "main",
      "createdBy": "a person",
      "prompt": {
        "content": "/deliver-issue 12"
      },
      "promptWrittenBy": "a person",
      "skills": [
        "commit",
        "deliver-issue",
        "develop",
        "open-pr",
        "orchestrate-issues",
        "test-fix",
        "triage-issue",
        "verify",
        "verify-recipes"
      ],
      "harness": "claude-code",
      "platform": "linux/amd64"
    }
  }
}
