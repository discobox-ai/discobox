#!/bin/sh
set -eu

interface=eth0
attempt=0
while ! ip link show dev "$interface" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 100 ]; then
        echo "$interface did not appear within 10 seconds" >&2
        exit 1
    fi
    sleep 0.1
done

ip link set dev "$interface" up
ip address replace 192.168.127.2/24 dev "$interface"
ip route replace default via 192.168.127.1 dev "$interface"
