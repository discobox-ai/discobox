{
  "version": 1,
  "parameters": {
    "owner": {
      "type": "pathSegment"
    },
    "repo": {
      "type": "pathSegment"
    }
  },
  "routes": [
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "GET"
      ],
      "paths": [
        "/repos/${owner}/${repo}",
        "/repos/${owner}/${repo}/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/labels"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "PATCH"
      ],
      "paths": [
        "/repos/${owner}/${repo}/labels/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/labels"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "DELETE"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/labels/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/comments"
      ]
    }
  ]
}
