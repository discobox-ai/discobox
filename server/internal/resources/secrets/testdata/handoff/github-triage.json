{
  "version": 1,
  "parameters": {
    "owner": {
      "type": "pathSegment"
    },
    "repo": {
      "type": "pathSegment"
    }
  },
  "routes": [
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "GET"
      ],
      "paths": [
        "/repos/${owner}/${repo}",
        "/repos/${owner}/${repo}/**"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "GET"
      ],
      "paths": [
        "/search/issues"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "paths": [
        "/graphql"
      ],
      "graphql": {
        "operations": [
          "query"
        ]
      }
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues/*/comments"
      ]
    },
    {
      "hosts": [
        "api.github.com"
      ],
      "methods": [
        "POST"
      ],
      "paths": [
        "/repos/${owner}/${repo}/issues"
      ]
    }
  ]
}
