[Unit]
Description=Discobox Sandbox Agent
Documentation=https://github.com/discobox-ai/discobox
After=network-online.target docker.socket nix-daemon.socket
Wants=network-online.target docker.socket nix-daemon.socket
ConditionPathExists=/etc/discobox/sandbox.json

[Service]
Type=simple
Environment=PATH=/nix/var/nix/profiles/default/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NIX_REMOTE=daemon
ExecStartPre=/usr/bin/install -d -m 0700 /run/discobox/agent-terminals
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/discobox /workspace
ExecStart=/usr/local/bin/discobox-sandbox-agent --config /etc/discobox/sandbox.json
StandardOutput=journal+console
StandardError=journal+console
Restart=on-failure
RestartSec=2s
KillMode=mixed

[Install]
WantedBy=multi-user.target
