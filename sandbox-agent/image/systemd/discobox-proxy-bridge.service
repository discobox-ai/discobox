[Unit]
Description=Discobox Sandbox Proxy Bridge
Documentation=https://github.com/discobox-ai/discobox
After=network-online.target
Wants=network-online.target
Before=discobox-sandbox-agent.service
# The material arrives in the pool's runtime-config document after boot, so on
# a sandbox's first boot the condition fails and the intake starts this unit
# once it is in place, and restarts it whenever a delivery changes it
# (ADR 26-10-08-127 §5).
ConditionPathExists=/etc/discobox/proxy/bridge.json

[Service]
Type=simple
ExecStart=/usr/local/bin/discobox-sandbox-agent proxy-bridge --config /etc/discobox/proxy/bridge.json --dns
StandardOutput=journal+console
StandardError=journal+console
Restart=on-failure
RestartSec=2s
KillMode=mixed

[Install]
WantedBy=multi-user.target
