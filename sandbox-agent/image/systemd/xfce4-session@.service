[Unit]
Description=Xfce desktop session on display :0
Requires=xvfb.service discobox-session-bus.service
After=xvfb.service discobox-session-bus.service
# The session reads the desktop scale from an environment file, and GDK_SCALE is
# read once per process. The boot flow writes that file before systemd starts;
# the viewer rewrites it when the scale changes. Ordering after the viewer's
# Type=notify readiness is a backstop for a viewer run where boot has not
# written it. Ordering only, not Requires: a boot where the viewer fails still
# gets a desktop, at the scale boot wrote.
After=discobox-desktop.service
# discobox-render-proxy-env.service writes the proxy environment file below from
# sandbox.json, so it has to have run first.
After=discobox-render-proxy-env.service
PartOf=xvfb.service

[Service]
Type=simple
User=%i
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/discobox/session/bus
# Proxy and trust settings for everything launched from the desktop. systemd
# starts this unit, not sandbox-agent, so none of the environment a sandbox
# terminal gets reaches it. Without these, Chromium from the desktop icon connects
# directly, and the sandbox has no route out except through the proxy
# (DNS_PROBE_FINISHED_NO_INTERNET). This is the same file dockerd and nix-daemon
# read; see the proxyenv package. `-`: a sandbox with no MITM proxy has none.
# Its NO_PROXY is resolved at boot, so a network created later (the default
# Docker bridge included) is sent to the proxy from the desktop.
EnvironmentFile=-/run/discobox/proxy/proxy.env
# The server has to agree with scale.env before anything in the session
# starts: that file is only the launch-time half of the scale, and the density,
# cursor size and window decorations it goes with are otherwise applied only by
# the viewer -- which is not running when a program talking to :0 is what
# brought X up. See desktop.PrepareSession. `-`: a failure leaves a
# desktop at mismatched density, which beats no desktop at all -- until the
# next session start or scale change, since the viewer already counts the
# scale as applied and does not redo it.
ExecStartPre=-/usr/local/bin/discobox-sandbox-agent desktop prepare-session
# xfce4-session, not startxfce4: the wrapper's job is to start an X server, a
# D-Bus session and then the session manager, and all three of those are units
# here already.
ExecStart=/usr/bin/xfce4-session
# always, not on-failure: the applications menu has a Log Out entry, and a
# person who finds it in a container has otherwise ended their own desktop with
# no way back to it. Restarting turns that into "start my session over".
# A systemd-initiated stop -- which is what PartOf=xvfb.service issues -- is not
# a restart, so the session still goes away with the X server.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
