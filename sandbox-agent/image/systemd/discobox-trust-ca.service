[Unit]
Description=Discobox Trust Proxy MITM CA
Documentation=https://github.com/obot-platform/discobox
DefaultDependencies=no
After=local-fs.target
Before=discobox-sandbox-agent.service discobox-proxy-bridge.service sysinit.target
ConditionPathExists=/etc/discobox/proxy/mitm-ca.crt

[Service]
Type=oneshot
RemainAfterExit=yes
# The anchor filename is derived from the CA's own fingerprint, not fixed:
# a filesystem can hold more than one Discobox MITM CA (there is one per pool,
# and a sandbox nested inside another sees both its own and its host's). A
# fixed name makes those collide, and because the file may be a bind mount
# from the outer sandbox, unlink-and-replace fails EBUSY and leaves this
# sandbox trusting the wrong CA. discobox-ca-anchor shares the naming rule
# with the runc wrapper so neither side can drift.
#
# -store makes the same command materialize the trust store the anchors belong
# in, which is what this unit used to call update-ca-certificates for. That
# tool rebuilds everything at a fixed ~0.8s whether it adds one CA or 152, and
# this unit is ordered ahead of the sandbox agent, so every sandbox paid it
# before its terminal could exist. The image ships the finished system store at
# -prebuilt; only the anchors are added here.
ExecStart=/usr/local/bin/discobox-ca-anchor -store /etc/ssl/certs /etc/discobox/proxy/mitm-ca.crt /usr/local/share/ca-certificates
# Stage the same augmented bundle under the trust-store path convention of
# other distro families, for sandbox-agent's runc wrapper (docs/adr/0020) to
# bind-mount into nested Docker containers built from a non-Debian base. This
# process never runs update-ca-certificates inside a container itself — that
# would land in the container's committed layer — it only mounts these
# pre-staged, already-updated files read-only.
#
# They land under /run rather than beside the CA in /etc/discobox/proxy because
# that path is pool-agent's read-only bind mount of the sandbox's proxy config;
# staging into it fails with EROFS. /run is the sandbox's writable runtime tree
# (the same one discobox-sandbox-agent.service stages into) and is tmpfs, which
# matches these files' lifetime — they are derived from the CA bundle this unit
# just rebuilt and are meant to be regenerated every boot, never persisted.
ExecStart=/usr/bin/install -D -m 0644 /etc/ssl/certs/ca-certificates.crt /run/discobox/proxy/ca-bundles/debian.pem
ExecStart=/usr/bin/install -D -m 0644 /etc/ssl/certs/ca-certificates.crt /run/discobox/proxy/ca-bundles/alpine.pem
ExecStart=/usr/bin/install -D -m 0644 /etc/ssl/certs/ca-certificates.crt /run/discobox/proxy/ca-bundles/rhel.pem

[Install]
WantedBy=sysinit.target
