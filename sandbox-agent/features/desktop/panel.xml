<?xml version="1.0" encoding="UTF-8"?>
<!--
  Replaces Debian's two-panel default (a full top bar plus a macOS-style dock)
  with one 30px bar across the bottom.

  A sandbox desktop is watched inside a browser window that is already smaller
  than a screen, and every row of panel is a row of application taken away. The
  bottom edge is where a taskbar is expected to be, and it is also the edge the
  viewer's own top bar is furthest from, so the page's chrome and the desktop's
  do not stack into one thick band across the top of the window.

  p=10 in the position string is the bottom edge -- the same value Debian's own
  bottom panel uses, where p=6 is the top one. At length=100 the panel spans the
  screen either way, so the x offset in that string never comes into play.

  The background is set here rather than in the GTK theme because xfce4-panel
  has its own property for it, and because the panel is chrome rather than an
  application: it wears the viewer's near-black, not the theme's window grey.
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="size" type="uint" value="30"/>
      <property name="enter-opacity" type="uint" value="100"/>
      <property name="leave-opacity" type="uint" value="100"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.043137"/>
        <value type="double" value="0.035294"/>
        <value type="double" value="0.054902"/>
        <value type="double" value="1.000000"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="applicationsmenu">
      <property name="show-button-title" type="bool" value="false"/>
      <property name="button-icon" type="string" value="/usr/local/share/discobox/desktop/mark.png"/>
    </property>
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-3" type="string" value="tasklist">
      <property name="grouping" type="uint" value="1"/>
      <property name="show-handle" type="bool" value="false"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-labels" type="bool" value="true"/>
    </property>
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-5" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
    <property name="plugin-6" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%H:%M"/>
    </property>
    <property name="plugin-7" type="string" value="showdesktop"/>
  </property>
</channel>
