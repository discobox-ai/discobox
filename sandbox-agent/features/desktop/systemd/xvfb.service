[Unit]
Description=Xdummy virtual X11 display on :0

[Service]
# simple, so started means forked: Xorg has no sd_notify. Every unit that talks
# to the display is ordered After= this one -- x11-display.service first, the
# proxy forwarding the very connection that started X -- so the ExecStartPost
# below is what makes started mean accepting connections on 127.0.0.1:6000.
# Without it the activating client is forwarded into "Connection refused".
Type=simple
# Only the lock is Xorg's to clean up. /tmp/.X11-unix/X0 belongs to
# x11-display.socket, which is listening on it, and removing it unlinks the path
# clients reach :0 through: the display would socket-activate exactly once and
# then be unreachable.
#
# For the same reason Xorg must not listen on that path itself: with xtrans's
# unix transport on, it unlinks the file systemd bound, binds its own there,
# and unlinks that on exit, so a stop leaves nothing to activate X again. Hence
# -nolisten unix. -listen local is the Linux abstract socket
# @/tmp/.X11-unix/X0, which libxcb tries before the file: while X runs,
# clients reach it directly over a unix socket, where Xorg can read their
# credentials and so let them attach MIT-SHM segments (over TCP it refuses
# that, and x11vnc dies on the refusal); while X is down the abstract connect
# is refused and they fall back to the file, which starts it. -listen tcp is
# what x11-display.service proxies the activating connection to.
ExecStartPre=-/bin/rm -f /tmp/.X0-lock
ExecStart=/usr/lib/xorg/Xorg :0 -config /etc/X11/xorg-dummy.conf -noreset -ac -listen tcp -listen local -nolisten unix +extension RANDR
ExecStartPost=/bin/bash -c 'for i in {1..300}; do : 2>/dev/null > /dev/tcp/127.0.0.1/6000 && exit 0; sleep 0.1; done; echo "Xorg is not accepting connections on 127.0.0.1:6000" >&2; exit 1'
Restart=on-failure
RestartSec=2
