[Unit]
Description=Xdummy virtual X11 display on :0

[Service]
# simple, so started means forked: Xorg has no sd_notify. Every unit that talks
# to the display is ordered After= this one -- x11-display.service first, the
# proxy forwarding the very connection that started X -- so the ExecStartPost
# below is what makes started mean accepting connections on 127.0.0.1:6000.
# Without it the activating client is forwarded into "Connection refused".
Type=simple
# Only the lock is Xorg's to clean up. /tmp/.X11-unix/X0 belongs to
# x11-display.socket, which is listening on it: Xorg runs -nolisten local and
# never creates it, and removing it unlinks the path clients reach :0 through,
# so the display would socket-activate exactly once and then be unreachable.
ExecStartPre=-/bin/rm -f /tmp/.X0-lock
ExecStart=/usr/lib/xorg/Xorg :0 -config /etc/X11/xorg-dummy.conf -noreset -ac -listen tcp -nolisten local +extension RANDR
ExecStartPost=/bin/bash -c 'for i in {1..300}; do : 2>/dev/null > /dev/tcp/127.0.0.1/6000 && exit 0; sleep 0.1; done; echo "Xorg is not accepting connections on 127.0.0.1:6000" >&2; exit 1'
Restart=on-failure
RestartSec=2
