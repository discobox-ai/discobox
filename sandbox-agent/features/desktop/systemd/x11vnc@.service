[Unit]
Description=x11vnc VNC server (per-connection)
Requires=xvfb.service
# xvfb.service counts as started only once Xorg accepts connections, so this
# needs no wait of its own.
After=xvfb.service

[Service]
Type=simple
NoNewPrivileges=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
ExecStart=/usr/bin/x11vnc -inetd -display :0 -once -shared -nopw -xrandr resize
StandardInput=socket
StandardOutput=socket
StandardError=journal
