{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/discobox-ai/discobox/main/cli/credential-policy.schema.json",
  "title": "Discobox credential policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {
          "const": "policy"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "pathSegment"
          },
          "optional": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]*$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        },
        "required": [
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "required": [
                "default"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "boolean"
          },
          "graphql": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operations": {
                "type": "array",
                "items": {
                  "enum": [
                    "query",
                    "mutation",
                    "subscription"
                  ]
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "places": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(/|form:[^=, \\t]+$)",
                  "description": "A JSON pointer into a JSON body, starting with /, or form:NAME for the field of a URL-encoded form body with that decoded name."
                }
              }
            },
            "required": [
              "places"
            ]
          },
          "websocket": {
            "type": "object",
            "additionalProperties": false,
            "description": "Places in the JSON messages a client sends on the WebSocket connection this route's request upgrades. The credential is swapped only as the whole string at a place's pointer, in a message whose top-level members hold every condition. A route without this block allows the credential in no message.",
            "properties": {
              "places": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "string",
                      "pattern": "^/",
                      "description": "A JSON pointer into the message, such as /d/token."
                    },
                    "when": {
                      "type": "object",
                      "description": "Top-level members and the JSON scalar each must hold, compared exactly.",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  },
                  "required": [
                    "at"
                  ]
                }
              }
            },
            "required": [
              "places"
            ]
          }
        },
        "required": [
          "hosts"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "graphql",
                "mcp"
              ]
            }
          },
          {
            "not": {
              "required": [
                "body",
                "graphql"
              ]
            }
          },
          {
            "not": {
              "required": [
                "body",
                "mcp"
              ]
            }
          },
          {
            "not": {
              "required": [
                "body",
                "websocket"
              ]
            }
          },
          {
            "not": {
              "required": [
                "graphql",
                "websocket"
              ]
            }
          },
          {
            "not": {
              "required": [
                "mcp",
                "websocket"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "routes"
  ]
}
