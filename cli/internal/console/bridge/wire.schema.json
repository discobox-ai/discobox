        },
        {
          "const": "reconnecting"
        },
        {
          "const": "reconnected"
        }
      ]
    },
    "ResizePayload": {
      "type": "object",
      "properties": {
        "cols": {
          "type": "integer",
          "format": "uint16"
        },
        "rows": {
          "type": "integer",
          "format": "uint16"
        }
      },
      "required": [
        "cols",
        "rows"
      ]
    }
