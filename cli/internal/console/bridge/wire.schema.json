      "properties": {
        "stream": {
          "type": "integer",
          "format": "uint32"
        },
        "box": {
          "type": "string"
        },
        "exec": {
          "type": "string"
        },
        "cols": {
          "type": "integer",
          "format": "int64"
        },
        "rows": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "stream",
        "box",
        "exec",
        "cols",
        "rows"
      ]
