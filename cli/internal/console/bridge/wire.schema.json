      "properties": {
        "stream": {
          "type": "integer",
          "format": "uint32"
        }
      },
      "required": [
        "stream"
      ]
    },
    "Stream": {
      "description": "Stream says a stream's state changed. A failed stream is forgotten.",
      "type": "object",
      "properties": {
        "stream": {
          "type": "integer",
          "format": "uint32"
        },
        "state": {
          "$ref": "#/$defs/StreamState"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "state"
      ]
    },
