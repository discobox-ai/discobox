      ]
    },
    "Forward": {
      "description": "Forward is one box port at a local one.",
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "format": "int64"
        },
        "udp": {
          "type": "boolean"
        },
        "local": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "port",
        "local"
      ]
    },
    "Sessions": {
      "description": "Sessions is what a box's workspace opens, by the core's rules: its sessions in tab order, the primary first, and its declared services. Running is false for a box that is not running: only its primary opens, and attaching it is what waits for the box.",
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tab"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          }
        }
      },
      "required": [
        "running",
        "sessions",
        "services"
      ]
    },
    "Tab": {
      "description": "Tab is one session as the app draws its tab. Kind is the column and what it is.",
      "type": "object",
      "properties": {
        "exec": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TabKind"
        },
        "title": {
          "type": "string"
        },
        "live": {
          "type": "boolean"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "exec",
        "kind",
        "title",
        "live",
        "argv"
      ]
    },
    "TabKind": {
      "description": "TabKind is what a session is, which says the column its tab is in.",
      "type": "string",
      "oneOf": [
        {
          "description": "TabPrimary is the box's primary session, its harness.",
          "const": "primary"
        },
        {
          "description": "TabTerminal is another harness terminal.",
          "const": "terminal"
        },
        {
          "description": "TabShell is a shell.",
          "const": "shell"
        },
        {
          "description": "TabTool is a tool's session.",
          "const": "tool"
        },
        {
          "description": "TabService is a declared service's session.",
          "const": "service"
        }
      ]
    },
    "Service": {
      "description": "Service is one declared service.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "exec": {
          "description": "Exec is the session it runs in, when it has one.",
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ]
    },
    "Command": {
      "description": "Command runs a registry command. ID is the app's, unique for the bridge's life, and is what its result, forms, questions and progress name. Targets are box keys, explicit: a box command never falls back to what is on screen.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64"
        },
        "command": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "args": {
          "$ref": "#/$defs/Args"
        }
      },
      "required": [
        "id",
        "command",
        "targets",
        "context",
        "args"
      ]
    },
    "Context": {
      "description": "Context is where the command is asked from (console.Context): navigation is the app's, and the core is handed the parts of it its rules read.",
      "type": "object",
      "properties": {
        "workspace": {
          "description": "Workspace is the key of the box whose workspace the window holds.",
          "type": "string"
        },
        "hasWorkspace": {
          "type": "boolean"
        },
        "workspaceShown": {
          "type": "boolean"
        },
        "paneFocused": {
          "type": "boolean"
        },
        "listHasKeys": {
          "type": "boolean"
        },
        "tree": {
          "type": "boolean"
        },
        "treeShown": {
          "type": "boolean"
        },
        "treeFits": {
          "type": "boolean"
        },
        "pageShown": {
          "type": "boolean"
        }
      }
    },
    "Args": {
      "description": "Args are what a command takes beyond its targets: the stream a session it makes is attached to and the size of its pane (shell, terminal), and the session it acts on (end, repaint).",
      "type": "object",
      "properties": {
        "stream": {
          "type": "integer",
          "format": "uint32"
        },
        "cols": {
          "type": "integer",
          "format": "int64"
        },
        "rows": {
          "type": "integer",
          "format": "int64"
        },
        "exec": {
          "type": "string"
        }
      }
    },
    "Result": {
      "description": "Result ends a command (or an upload, by its ID).",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "why": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "box": {
          "description": "Box is the box the flow entered is about.",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/Tab",
          "description": "Session is the session a shell or terminal made, attached to the command's stream."
        },
        "entries": {
          "description": "Entries are what the palette and the action menu list, as they stand for the command's context and targets.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "path": {
          "description": "Path is where an upload landed in the box.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "Status": {
      "description": "Status is how a command ended.",
      "type": "string",
      "oneOf": [
        {
          "description": "StatusDone is a command the core carried out; Note says what came of it.",
          "const": "done"
        },
        {
          "description": "StatusFailed is one refused or that failed; Why says why.",
          "const": "failed"
        },
        {
          "description": "StatusCanceled is one whose form or question was dismissed.",
          "const": "canceled"
        },
        {
          "description": "StatusEnter is one whose flow is the app's: the core has ruled it can run, and the app enters it — moving focus, opening a page or a menu, opening the box's workspace (Box).",
          "const": "enter"
        }
      ]
    },
    "Entry": {
      "description": "Entry is one command as it stands: whether it can act, and why not. Uses is how often this window has used it, which ranks the palette.",
