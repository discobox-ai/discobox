            "$ref": "#/$defs/AuditRecord"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "records",
        "missing"
      ]
    },
    "AuditRecord": {
      "description": "AuditRecord is one line of the timeline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "groupSummary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "time",
        "source",
        "summary"
      ]
    },
    "Forwards": {
