        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "uses": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "command",
        "label",
        "detail",
        "enabled"
      ]
    },
