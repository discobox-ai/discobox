          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "masked": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "applies": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "choices",
        "value",
        "applies"
      ]
