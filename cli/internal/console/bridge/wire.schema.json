{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discobox desktop bridge",
  "description": "What crosses the pipe between `discobox desktop` and its app: the JSON messages, the payloads of the terminal frames, and the frame kinds. Generated from the Go types in cli/internal/console/bridge by its genwire command; no field is ever null.",
  "$ref": "#/$defs/Message",
  "x-protocol": 2,
  "x-specVersion": 4,
  "x-frameKinds": {
    "json": {
      "kind": 255,
      "description": "A JSON message (Message), on stream 0."
    },
    "input": {
      "kind": 0,
      "description": "Bytes typed into a stream's terminal (app)."
    },
    "stdout": {
      "kind": 1,
      "description": "A stream's terminal output (CLI)."
    },
    "stderr": {
      "kind": 2,
      "description": "A stream's error output (CLI)."
    },
    "resize": {
      "kind": 3,
      "description": "A stream's terminal size, a ResizePayload (app)."
    },
    "exit": {
      "kind": 6,
      "description": "A stream's end; its payload is why, empty when it ended cleanly (CLI)."
    },
    "repaint": {
      "kind": 14,
      "description": "Asks for a stream's screen again (app); no payload."
    }
  },
  "$defs": {
    "Message": {
      "description": "Message is one JSON message: its type, and the body of that type.",
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/Type"
        },
        "hello": {
          "$ref": "#/$defs/Hello"
        },
        "welcome": {
          "$ref": "#/$defs/Welcome"
        },
        "subscribe": {
          "$ref": "#/$defs/Subscribe"
        },
        "unsubscribe": {
          "$ref": "#/$defs/Unsubscribe"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "command": {
          "$ref": "#/$defs/Command"
        },
        "result": {
          "$ref": "#/$defs/Result"
        },
        "form": {
          "$ref": "#/$defs/Form"
        },
        "submit": {
          "$ref": "#/$defs/Submit"
        },
        "fieldErrors": {
          "$ref": "#/$defs/FieldErrors"
        },
        "question": {
          "$ref": "#/$defs/Question"
        },
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "edit": {
          "$ref": "#/$defs/Edit"
        },
        "saved": {
          "$ref": "#/$defs/Saved"
        },
        "upload": {
          "$ref": "#/$defs/Upload"
        },
        "open": {
          "$ref": "#/$defs/Open"
        },
        "close": {
          "$ref": "#/$defs/Close"
        },
        "stream": {
          "$ref": "#/$defs/Stream"
        }
      },
      "required": [
        "type"
      ]
    },
    "Type": {
      "description": "Type names a message.",
      "type": "string",
      "oneOf": [
        {
          "description": "TypeHello opens the bridge (app).",
          "const": "hello"
        },
        {
          "description": "TypeWelcome answers it with the protocol, the spec and the session (CLI).",
          "const": "welcome"
        },
        {
          "description": "TypeSubscribe and TypeUnsubscribe start and stop a topic (app).",
          "const": "subscribe"
        },
        {
          "const": "unsubscribe"
        },
        {
          "description": "TypeSnapshot is a topic's value, whole, on subscribe and on every change (CLI).",
          "const": "snapshot"
        },
        {
          "description": "TypeCommand runs a registry command (app).",
          "const": "command"
        },
        {
          "description": "TypeResult ends a command or an upload (CLI).",
          "const": "result"
        },
        {
          "description": "TypeForm is a form a command needs filled (CLI); TypeSubmit fills it (app); TypeFieldErrors is the core's refusal of what was submitted (CLI).",
          "const": "form"
        },
        {
          "const": "submit"
        },
        {
          "const": "fieldErrors"
        },
        {
          "description": "TypeQuestion is a question a running command asks (CLI); TypeAnswer answers it (app).",
          "const": "question"
        },
        {
          "const": "answer"
        },
        {
          "description": "TypeProgress is a running command's report, warning or acceptance (CLI).",
          "const": "progress"
        },
        {
          "description": "TypeEdit is a file for the app to open in the user's editor (CLI); TypeSaved is the app's word that it was saved (app).",
          "const": "edit"
        },
        {
          "const": "saved"
        },
        {
          "description": "TypeUpload is a pasted or dropped image for a box (app).",
          "const": "upload"
        },
        {
          "description": "TypeOpen attaches a stream the app allocated to a session, and TypeClose detaches it, ending nothing in the box (app).",
          "const": "open"
        },
        {
          "const": "close"
        },
        {
          "description": "TypeStream is a stream's state: attached, failed, reconnecting, reconnected (CLI). Its output and its end are frames on the stream.",
          "const": "stream"
        }
      ]
    },
    "Hello": {
      "description": "Hello is the app's first message.",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "protocol"
      ]
    },
    "Welcome": {
      "description": "Welcome answers hello. Spec and Session are sent only when the protocols match: another version's fields may not parse.",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "int64"
        },
        "spec": {
          "$ref": "#/$defs/Spec"
        },
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "protocol"
      ]
    },
    "Spec": {
      "description": "Spec is the console's spec as a frontend is handed it.",
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "format": "int64"
        },
        "colors": {
          "description": "Colors is every color token by name, in both palettes.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecColor"
          }
        },
        "dimensions": {
          "description": "Dimensions is every space, radius and stroke token by name, in points.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "states": {
          "description": "States and Agents are the glyphs, by state.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Glyph"
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Glyph"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecCommand"
          }
        },
        "gestures": {
          "description": "Gestures are the bindings that are not commands (Gesture): every key a frontend's list, tree, leader and panes bind is a command's or one of these.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecGesture"
          }
        }
      },
      "required": [
        "version",
        "colors",
        "dimensions",
        "states",
        "agents",
        "commands",
        "gestures"
      ]
    },
    "SpecColor": {
      "description": "SpecColor is one color token: its dark and light values as #rrggbb, and the xterm-256 index the TUI draws it with (0 where it uses none).",
      "type": "object",
      "properties": {
        "dark": {
          "type": "string"
        },
        "light": {
          "type": "string"
        },
        "xterm": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "dark",
        "light"
      ]
    },
    "Glyph": {
      "description": "Glyph is how a state is drawn: its shape, the color token it is drawn in, and the word that stands for it where there is no color. An empty Color is the surrounding text's.",
      "type": "object",
      "properties": {
        "glyph": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "word": {
          "type": "string"
        }
      },
      "required": [
        "glyph",
        "color",
        "word"
      ]
    },
    "SpecCommand": {
      "description": "SpecCommand is one registry command as a frontend is handed it. Every list is present, empty where there is nothing in it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "$ref": "#/$defs/SpecTarget"
        },
        "lifecycle": {
          "type": "boolean"
        },
        "bindings": {
          "$ref": "#/$defs/SpecBindings"
        }
      },
      "required": [
        "id",
        "label",
        "detail",
        "aliases",
        "target",
        "lifecycle",
        "bindings"
      ]
    },
    "SpecTarget": {
      "description": "SpecTarget is what a command takes, as a frontend is handed it.",
      "type": "string",
      "oneOf": [
        {
          "description": "SpecTargetBox is a command that takes a box.",
          "const": "box"
        },
        {
          "description": "SpecTargetWindow is one that takes none: it acts on the window.",
          "const": "window"
        }
      ]
    },
    "SpecBindings": {
      "description": "SpecBindings is a command's bindings, keyed by frontend (598 §2).",
      "type": "object",
      "properties": {
        "tui": {
          "$ref": "#/$defs/SpecTUIBinding"
        },
        "desktop": {
          "$ref": "#/$defs/SpecDesktopBinding"
        }
      },
      "required": [
        "tui",
        "desktop"
      ]
    },
    "SpecTUIBinding": {
      "description": "SpecTUIBinding is TUIBinding on the wire.",
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leader": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "repeats": {
          "type": "boolean"
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "menu": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "keys",
        "leader",
        "repeats",
        "chords",
        "menu"
      ]
    },
    "SpecDesktopBinding": {
      "description": "SpecDesktopBinding is DesktopBinding on the wire.",
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "keys"
      ]
    },
    "SpecGesture": {
      "description": "SpecGesture is one gesture as a frontend is handed it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bindings": {
          "$ref": "#/$defs/SpecBindings"
        }
      },
      "required": [
        "id",
        "label",
        "bindings"
      ]
    },
    "Session": {
      "description": "Session is what the window is opened on.",
      "type": "object",
      "properties": {
        "primaryServer": {
          "description": "PrimaryServer is the configured server's name.",
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "directory": {
          "description": "Directory and Branch are where the CLI was run, which a create cuts from.",
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "required": [
        "primaryServer"
      ]
    },
    "Subscribe": {
      "description": "Subscribe starts following a topic. Sub is the app's, unique for the bridge's life; Box is the box key, for a topic about one box.",
      "type": "object",
      "properties": {
        "sub": {
          "type": "integer",
          "format": "uint32"
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        },
        "box": {
          "type": "string"
        }
      },
      "required": [
        "sub",
        "topic"
      ]
    },
    "Topic": {
      "description": "Topic is what a subscription follows.",
      "type": "string",
      "oneOf": [
        {
          "description": "TopicListing is the boxes, across every server.",
          "const": "listing"
        },
        {
          "description": "TopicResources is what Discobox has on this machine and is using.",
          "const": "resources"
        },
        {
          "description": "TopicRequests is the credential and approval requests waiting on a person, and the credentials refused.",
          "const": "requests"
        },
        {
          "description": "TopicProvisioning is what a box that is not usable yet is being made to do (Box).",
          "const": "provisioning"
        },
        {
          "description": "TopicAudit is a box's audit timeline, followed (Box).",
          "const": "audit"
        },
        {
          "description": "TopicForwards is a box's ports forwarded to this machine, for as long as the subscription lasts (Box).",
          "const": "forwards"
        },
        {
          "description": "TopicSessions is what a box's workspace opens: its sessions and services, as the core orders and names them (Box).",
          "const": "sessions"
        }
      ]
    },
    "Unsubscribe": {
      "description": "Unsubscribe stops one.",
      "type": "object",
      "properties": {
        "sub": {
          "type": "integer",
          "format": "uint32"
        }
      },
      "required": [
        "sub"
      ]
    },
    "Snapshot": {
      "description": "Snapshot is a topic's value, whole. Error is why it could not be read this time; the last value stands until one can. Exactly one value is set for the topic, unless Error is.",
      "type": "object",
      "properties": {
        "sub": {
          "type": "integer",
          "format": "uint32"
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        },
        "error": {
          "type": "string"
        },
        "listing": {
          "$ref": "#/$defs/Listing"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "requests": {
          "$ref": "#/$defs/Requests"
        },
        "provisioning": {
          "$ref": "#/$defs/Provisioning"
        },
        "audit": {
          "$ref": "#/$defs/Audit"
        },
        "forwards": {
          "$ref": "#/$defs/Forwards"
        },
        "sessions": {
          "$ref": "#/$defs/Sessions"
        }
      },
      "required": [
        "sub",
        "topic"
      ]
    },
    "Listing": {
      "description": "Listing is the boxes, newest first, and the servers that did not answer.",
      "type": "object",
      "properties": {
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Box"
          }
        },
        "unreachable": {
          "description": "Unreachable are servers that did not answer; Waiting, ones still being asked with nothing of theirs to show.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "boxes",
        "unreachable",
        "waiting"
      ]
    },
    "Box": {
      "description": "Box is one box as the app draws its row.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Key is what the app names the box by in every message: its ID when one server is configured, the server's name and the ID otherwise. Opaque to the app, which shows ID.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "agent": {
          "type": "string"
        },
        "agentMsg": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "dirty": {
          "description": "Dirty is uncommitted work; Ahead, clean commits beyond the spawn commit (console.Sandbox.Uncommitted, Ahead).",
          "type": "boolean"
        },
        "ahead": {
          "type": "boolean"
        },
        "added": {
          "type": "integer",
          "format": "int64"
        },
        "deleted": {
          "type": "integer",
          "format": "int64"
        },
        "cpu": {
          "description": "CPU and MemoryBytes are what a box that is up is using; none for one that is not.",
          "type": "integer",
          "format": "int64"
        },
        "memoryBytes": {
          "type": "integer",
          "format": "int64"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "parent": {
          "description": "Parent is the key of the box that made this one.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "provisioning": {
          "type": "string"
        },
        "attachable": {
          "description": "Attachable is whether the box has a container to open now.",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "id",
        "name",
        "state",
        "harness",
        "source",
        "tags",
        "created",
        "attachable"
      ]
    },
    "State": {
      "description": "State is a sandbox's user-facing lifecycle state, narrowed to the six the launcher draws. The server reports more of them — stopping, archiving, deleting — but a picker only has to answer \"can I act on this\", and the transitional states answer that the same way the state they are heading for does.\n\nRepairing is kept apart from starting, which it is drawn like: a repair recorded and not yet landed, typed or automatic (ADR 26-10-12-711 §8). The box had failed, and the row says it is being rebuilt rather than that it is coming up for the first time.",
      "type": "string",
      "oneOf": [
        {
          "const": "running"
        },
        {
          "const": "starting"
        },
        {
          "const": "repairing"
        },
        {
          "const": "stopped"
        },
        {
          "description": "StateSuspended is a box frozen whole, its memory kept (ADR 26-10-16-420): up as far as acting on it goes — stop takes it — and off as far as anything inside it answering, which a start or a use brings back.",
          "const": "suspended"
        },
        {
          "const": "archived"
        },
        {
          "const": "error"
        }
      ]
    },
    "Resources": {
      "description": "Resources is the machine's capacity and use. Known is false until there is something measured to show.",
      "type": "object",
      "properties": {
        "known": {
          "type": "boolean"
        },
        "cpuVcpus": {
          "type": "number",
          "format": "double"
        },
        "cpuCapacity": {
          "type": "number",
          "format": "double"
        },
        "memoryBytes": {
          "type": "integer",
          "format": "int64"
        },
        "memoryCapacity": {
          "type": "integer",
          "format": "int64"
        },
        "diskKnown": {
          "type": "boolean"
        },
        "diskFreeBytes": {
          "type": "integer",
          "format": "int64"
        },
        "diskDataBytes": {
          "type": "integer",
          "format": "int64"
        },
        "diskCacheBytes": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "known",
        "cpuVcpus",
        "cpuCapacity",
        "memoryBytes",
        "memoryCapacity",
        "diskKnown",
        "diskFreeBytes",
        "diskDataBytes",
        "diskCacheBytes"
      ]
    },
    "Requests": {
      "description": "Requests is what waits on a person.",
      "type": "object",
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rejection"
          }
        }
      },
      "required": [
        "requests",
        "rejections"
      ]
    },
    "Request": {
      "description": "Request is one item waiting on a person. Box is the key of the box that asked, as the listing names it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "box": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RequestKind"
        },
        "name": {
          "type": "string"
        },
        "envVar": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "justification": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "box",
        "kind",
        "created"
      ]
    },
    "RequestKind": {
      "description": "RequestKind is what a request waits on a person for.",
      "type": "string",
      "oneOf": [
        {
          "description": "RequestCredential is a credential the box asked for.",
          "const": "credential"
        },
        {
          "description": "RequestRefresh is a credential to sign in again for.",
          "const": "refresh"
        },
        {
          "description": "RequestTrust is a host whose certificate the box asked to trust.",
          "const": "trust"
        },
        {
          "description": "RequestAdoption is a box asking to be adopted.",
          "const": "adoption"
        },
        {
          "description": "RequestAPIAccess is a box asking for access to the Discobox API.",
          "const": "apiAccess"
        }
      ]
    },
    "Rejection": {
      "description": "Rejection is a credential refused where a person is needed. Boxes are the listed boxes it affects (console.RejectionsFor): a harness's credential is refused for every box running that harness.",
      "type": "object",
      "properties": {
        "boxes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "server": {
          "type": "string"
        },
        "secretId": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "envName": {
          "type": "string"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "boxes",
        "secretId",
        "secretName",
        "host",
        "reason",
        "lastSeen"
      ]
    },
    "Provisioning": {
      "description": "Provisioning is what a box is being made to do now; empty once nothing is reported.",
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step"
      ]
    },
    "Audit": {
      "description": "Audit is a box's audit timeline: its most recent records, oldest first, and the trails the last read could not reach.",
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
